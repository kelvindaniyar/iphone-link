// Tahap 264 — Single-Process Native WinUI 3 Liquid Glass Shell (Slint + Direct3D 11 Child HWND)
// 100% Pure Native Rust Win64 — Zero WebView2, Zero Python, Zero Unicode Emojis.

import { FluentIcon } from "icons.slint";

export struct DeviceCardItem {
    udid: string,
    name: string,
    model: string,
    transport_badge: string,
    online: bool,
    selected: bool,
}

export struct DiagRow {
    label: string,
    status: string,
    ok: bool,
}

component TopIconBtn inherits Rectangle {
    in property <string> icon-name;
    in property <bool> dark-mode: true;
    in property <bool> active: false;
    in property <bool> accent-green: false;
    in property <bool> danger: false;
    in property <bool> caption-btn: false;
    in property <bool> close-btn: false;
    in property <length> btn-size: 26px;
    in property <length> icon-px: 14px;
    callback clicked();

    width: root.btn-size;
    height: root.btn-size;
    border-radius: 6px;
    border-width: root.caption-btn ? 0px : 1px;

    property <bool> hovered: ta.has-hover;

    border-color: root.danger ? (root.hovered ? #F87171 : #EF444477)
        : root.accent-green ? #10B981AA
        : root.active ? #0DA5F0AA
        : (root.dark-mode ? (root.hovered ? #FFFFFF44 : #FFFFFF24) : (root.hovered ? #0F172A4D : #0F172A24));

    background: root.danger ? (root.hovered ? #DC2626AA : #991B1B44)
        : root.close-btn ? (root.hovered ? #C42B1C : transparent)
        : root.accent-green ? (root.dark-mode ? #065F4666 : #10B98133)
        : root.active ? (root.dark-mode ? #0EA5E938 : #0EA5E928)
        : root.caption-btn ? (root.hovered ? (root.dark-mode ? #FFFFFF18 : #00000018) : transparent)
        : (root.dark-mode ? (root.hovered ? #FFFFFF24 : #FFFFFF12) : (root.hovered ? #FFFFFFCC : #FFFFFF7A));

    animate background { duration: 150ms; easing: cubic-bezier(0.16, 1.0, 0.3, 1.0); }
    animate border-color { duration: 150ms; easing: cubic-bezier(0.16, 1.0, 0.3, 1.0); }

    FluentIcon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        name: root.icon-name;
        icon-size: root.icon-px;
        icon-color: root.close-btn && root.hovered ? #FFFFFF
            : root.danger ? #FCA5A5
            : root.accent-green ? (root.dark-mode ? #34D399 : #059669)
            : root.active ? #38BDF8
            : (root.dark-mode ? #E5E7EB : #1F2937);
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component SegPill inherits Rectangle {
    in property <string> label;
    in property <string> icon-name: "";
    in property <bool> active: false;
    in property <bool> dark-mode: true;
    in property <length> pill-height: 30px;
    in property <length> font-px: 11.5px;
    callback clicked();

    height: root.pill-height;
    horizontal-stretch: 1;
    border-radius: (root.pill-height / 2) - 1px;
    background: root.active ? @linear-gradient(90deg, #1B6BFF 0%, #0DA5F0 100%)
        : (ta.has-hover ? (root.dark-mode ? #FFFFFF1E : #0F172A18) : transparent);
    animate background { duration: 150ms; easing: cubic-bezier(0.16, 1.0, 0.3, 1.0); }

    HorizontalLayout {
        x: 6px;
        y: 0px;
        width: parent.width - 12px;
        height: parent.height;
        alignment: center;
        spacing: 5px;

        if root.icon-name != "" : FluentIcon {
            y: (parent.height - self.height) / 2;
            name: root.icon-name;
            icon-size: 13px;
            icon-color: root.active ? #FFFFFF : (root.dark-mode ? #CBD5E1 : #1E293B);
        }

        Text {
            text: root.label;
            color: root.active ? #FFFFFF : (root.dark-mode ? #D1D5DB : #0F172A);
            font-size: root.font-px;
            font-weight: root.active ? 600 : 500;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component ActionBtn inherits Rectangle {
    in property <string> label;
    in property <string> icon-name: "";
    in property <bool> dark-mode: true;
    in property <bool> primary: false;
    in property <bool> active: false;
    in property <bool> danger: false;
    in property <bool> emerald: false;
    in property <bool> wrap-label: false;
    in property <length> label-font-px: 11.5px;
    in property <int> fb-state: 0; // 0=idle, 1=busy, 2=ok, 3=err
    in property <string> fb-label: "";
    in property <length> btn-height: 32px;
    callback clicked();

    property <bool> is-ok: root.fb-state == 2;
    property <bool> is-err: root.fb-state == 3;
    property <bool> is-busy: root.fb-state == 1;
    property <string> eff-label: root.fb-label != "" ? root.fb-label : root.label;

    height: root.btn-height;
    border-radius: 9px;
    border-width: 1px;

    border-color: root.is-ok ? #10B981AA
        : root.is-err ? #EF4444AA
        : root.is-busy ? #38BDF8AA
        : root.primary ? #38BDF888
        : root.danger ? #EF444466
        : root.emerald ? #10B98188
        : root.active ? #0EA5E988
        : (root.dark-mode ? #3E424E : #CBD5E1);

    background: root.is-ok ? (root.dark-mode ? #065F4699 : #D1FAE5DD)
        : root.is-err ? (root.dark-mode ? #7F1D1D99 : #FEE2E2DD)
        : root.is-busy ? (root.dark-mode ? #0C4A6E88 : #E0F2FEDD)
        : root.primary ? @linear-gradient(90deg, #1B6BFF 0%, #0DA5F0 100%)
        : root.danger ? (ta.has-hover ? (root.dark-mode ? #7F1D1DCC : #FECACA) : (root.dark-mode ? #7F1D1D66 : #FEE2E2CC))
        : root.emerald ? (ta.has-hover ? (root.dark-mode ? #065F46CC : #A7F3D0) : (root.dark-mode ? #064E3B77 : #D1FAE5CC))
        : root.active ? #0EA5E938
        : (root.dark-mode ? (ta.has-hover ? #FFFFFF22 : #FFFFFF12) : (ta.pressed ? #DBEAFE : (ta.has-hover ? #E2E8F0CC : #FFFFFFAA)));
    animate background { duration: 150ms; easing: cubic-bezier(0.16, 1.0, 0.3, 1.0); }
    animate border-color { duration: 150ms; easing: cubic-bezier(0.16, 1.0, 0.3, 1.0); }

    HorizontalLayout {
        x: 7px;
        y: 0px;
        width: parent.width - 14px;
        height: parent.height;
        alignment: center;
        spacing: 5px;

        if root.icon-name != "" : FluentIcon {
            y: (parent.height - self.height) / 2;
            name: root.icon-name;
            icon-size: 13px;
            icon-color: root.is-ok ? (root.dark-mode ? #34D399 : #047857)
                : root.is-err ? (root.dark-mode ? #FCA5A5 : #B91C1C)
                : root.is-busy ? (root.dark-mode ? #7DD3FC : #0369A1)
                : root.primary ? #FFFFFF
                : root.danger ? (root.dark-mode ? #FCA5A5 : #B91C1C)
                : root.emerald ? (root.dark-mode ? #34D399 : #047857)
                : root.active ? (root.dark-mode ? #38BDF8 : #0284C7)
                : (root.dark-mode ? #E5E7EB : #0F172A);
        }

        Text {
            text: root.eff-label;
            color: root.is-ok ? (root.dark-mode ? #6EE7B7 : #065F46)
                : root.is-err ? (root.dark-mode ? #FECACA : #991B1B)
                : root.is-busy ? (root.dark-mode ? #BAE6FD : #0369A1)
                : root.primary ? #FFFFFF
                : root.danger ? (root.dark-mode ? #FCA5A5 : #B91C1C)
                : root.emerald ? (root.dark-mode ? #6EE7B7 : #065F46)
                : root.active ? (root.dark-mode ? #7DD3FC : #0369A1)
                : (root.dark-mode ? #E5E7EB : #0F172A);
            font-size: root.label-font-px;
            font-weight: root.primary || root.is-ok || root.is-err ? 600 : 500;
            vertical-alignment: center;
            horizontal-alignment: root.wrap-label ? center : left;
            wrap: root.wrap-label ? word-wrap : no-wrap;
            overflow: root.wrap-label ? clip : elide;
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component DrawerSlider inherits VerticalLayout {
    in property <string> label;
    in property <int> value: 0;
    in property <int> min-val: 0;
    in property <int> max-val: 100;
    in property <string> unit: "px";
    in property <bool> dark-mode: true;
    in property <bool> show-header: true;
    callback value-changed(int);

    spacing: 4px;

    property <float> ratio: root.max-val > root.min-val
        ? clamp((root.value - root.min-val) / (root.max-val - root.min-val), 0.0, 1.0)
        : 0.0;

    if root.show-header : HorizontalLayout {
        spacing: 6px;
        Text {
            text: root.label;
            color: root.dark-mode ? #D1D5DB : #374151;
            font-size: 11px;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        Rectangle {
            width: 58px;
            height: 22px;
            border-radius: 6px;
            border-width: 1px;
            border-color: root.dark-mode ? #FFFFFF26 : #0F172A22;
            background: root.dark-mode ? #0C111C66 : #FFFFFF99;
            Text {
                width: 100%;
                height: 100%;
                text: root.value + (root.unit != "" ? " " + root.unit : "");
                color: root.dark-mode ? #F8FAFC : #0F172A;
                font-size: 11px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    Rectangle {
        height: 18px;
        background: transparent;

        track := Rectangle {
            x: 0px;
            y: 7px;
            width: parent.width;
            height: 4px;
            border-radius: 2px;
            background: root.dark-mode ? #FFFFFF26 : #0F172A24;

            Rectangle {
                x: 0px;
                y: 0px;
                width: parent.width * root.ratio;
                height: 4px;
                border-radius: 2px;
                background: @linear-gradient(90deg, #1B6BFF 0%, #0DA5F0 100%);
            }
        }

        thumb := Rectangle {
            x: clamp((parent.width - 14px) * root.ratio, 0px, parent.width - 14px);
            y: 2px;
            width: 14px;
            height: 14px;
            border-radius: 7px;
            background: #FFFFFF;
            border-width: 2.5px;
            border-color: #0DA5F0;
        }

        slider-ta := TouchArea {
            mouse-cursor: pointer;
            function update-from-x(px: length) {
                root.value-changed(root.min-val + Math.round(clamp(px / max(self.width, 1px), 0.0, 1.0) * (root.max-val - root.min-val)));
            }
            pointer-event(ev) => {
                if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                    update-from-x(self.mouse-x);
                }
            }
            moved => {
                if (self.pressed) {
                    update-from-x(self.mouse-x);
                }
            }
        }
    }
}

component DrawerCard inherits Rectangle {
    in property <string> title: "";
    in property <bool> dark-mode: true;
    border-radius: 12px;
    border-width: 1px;
    border-color: root.dark-mode ? #FFFFFF29 : #FFFFFFD9;
    background: root.dark-mode ? #FFFFFF14 : #FFFFFF7D;
    animate background { duration: 180ms; easing: ease-in-out; }
    animate border-color { duration: 180ms; easing: ease-in-out; }

    VerticalLayout {
        padding: 10px;
        spacing: 7px;

        if root.title != "" : Text {
            text: root.title;
            color: root.dark-mode ? #CBD5E1 : #334155;
            font-size: 10px;
            font-weight: 700;
            wrap: word-wrap;
        }

        @children
    }
}

component ShortcutPillChip inherits Rectangle {
    in property <string> label;
    in property <bool> dark-mode: true;

    horizontal-stretch: 1;
    height: 25px;
    border-radius: 7px;
    border-width: 1px;
    border-color: root.dark-mode ? #FFFFFF24 : #0F172A1E;
    background: root.dark-mode ? #FFFFFF16 : #FFFFFFB8;
    animate background { duration: 150ms; easing: cubic-bezier(0.16, 1.0, 0.3, 1.0); }

    Text {
        x: 7px;
        y: 0px;
        width: parent.width - 14px;
        height: parent.height;
        text: root.label;
        color: root.dark-mode ? #F8FAFC : #0F172A;
        font-size: 10px;
        font-weight: 600;
        vertical-alignment: center;
        overflow: elide;
    }
}

component DrawerAccordion inherits Rectangle {
    in property <string> title;
    in property <string> badge: "";
    in property <bool> open: false;
    in property <bool> dark-mode: true;
    callback toggled();

    border-radius: 10px;
    border-width: 1px;
    border-color: root.dark-mode ? #FFFFFF24 : #FFFFFFC4;
    background: root.dark-mode ? #FFFFFF10 : #FFFFFF59;
    animate background { duration: 180ms; easing: ease-in-out; }

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        Rectangle {
            height: 32px;
            border-radius: 10px;
            background: acc-ta.has-hover
                ? (root.dark-mode ? #FFFFFF12 : #0F172A0E)
                : transparent;
            animate background { duration: 150ms; easing: ease-out; }

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 6px;
                Text {
                    horizontal-stretch: 1;
                    text: root.title;
                    color: root.dark-mode ? #E2E8F0 : #0F172A;
                    font-size: 10.5px;
                    font-weight: 700;
                    vertical-alignment: center;
                    overflow: elide;
                }
                if root.badge != "" : Rectangle {
                    y: (parent.height - self.height) / 2;
                    height: 18px;
                    width: bdg-txt.preferred-width + 10px;
                    border-radius: 9px;
                    background: root.dark-mode ? #1E3A5F99 : #DBEAFE;
                    bdg-txt := Text {
                        width: 100%;
                        height: 100%;
                        text: root.badge;
                        color: root.dark-mode ? #7DD3FC : #1D4ED8;
                        font-size: 9.5px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                FluentIcon {
                    y: (parent.height - self.height) / 2;
                    name: root.open ? "chevron-down" : "chevron-right";
                    icon-size: 12px;
                    icon-color: root.dark-mode ? #94A3B8 : #475569;
                }
            }

            acc-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.toggled(); }
            }
        }

        acc-clip := Rectangle {
            clip: true;
            height: root.open ? acc-body.preferred-height : 0px;
            opacity: root.open ? 1.0 : 0.0;
            animate height { duration: 200ms; easing: cubic-bezier(0.16, 1.0, 0.3, 1.0); }
            animate opacity { duration: 200ms; easing: cubic-bezier(0.16, 1.0, 0.3, 1.0); }

            acc-body := VerticalLayout {
                width: parent.width;
                padding-left: 9px;
                padding-right: 9px;
                padding-bottom: 9px;
                padding-top: 2px;
                spacing: 6px;
                @children
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "iPhone Link";
    preferred-width: 346px;
    preferred-height: 832px;
    min-width: 346px;
    min-height: 440px;
    no-frame: true;
    // CRITICAL for DirectComposition Layer 1 transparency: window background MUST stay transparent!
    // NOTE: Light-mode surface tokens keep #F4F7FC (at translucent frosted 42% alpha = #F4F7FC6B).
    background: transparent;

    // Appearance & layout properties
    in-out property <bool> dark-mode: true;
    in-out property <bool> lang-en: false;
    in-out property <bool> drawer-open: false;
    in-out property <float> drawer-slide-progress: 0.0;
    in-out property <length> drawer-animated-w: 0px;
    in-out property <bool> is-landscape: false;
    in-out property <bool> is-fullscreen: false;
    in-out property <int> rotation-deg: 0;
    in-out property <length> drawer-viewport-y: 0px;

    // DirectComposition 2-layer transparent video hole & Sequoia Blur-to-Sharp Reveal state
    in-out property <bool> video-layer-active: false;
    in-out property <bool> first-frame-ready: false;
    in-out property <length> video-hole-x: 0px;
    in-out property <length> video-hole-y: 38px;
    in-out property <length> video-hole-w: 346px;
    in-out property <length> video-hole-h: 750px;
    in-out property <image> reveal-blur-image;
    in-out property <bool> reveal-blur-visible: false;
    in-out property <float> reveal-blur-opacity: 0.0;
    in-out property <bool> transition-active: false;
    in-out property <float> standby-opacity: 1.0;
    in-out property <float> sequoia-opacity: 0.0;
    in-out property <float> sequoia-text-opacity: 0.0;
    in-out property <image> last-frame-blur-image;
    in-out property <bool> has-last-frame-blur: false;
    in-out property <bool> pin-revealed: false;
    in-out property <bool> acc-shortcuts-open: false;
    in-out property <bool> acc-bridge-open: true;
    in-out property <bool> acc-diag-open: true;
    in-out property <bool> acc-bt-fallback-open: false;
    in-out property <bool> acc-shortcut-guide-open: false;
    in-out property <bool> acc-updater-open: true;
    in-out property <bool> acc-details-open: false;
    in-out property <bool> acc-guide-open: false;

    // Session & device status properties
    in-out property <string> phase: "idle"; // "idle" | "starting" | "running"
    in-out property <string> stage: "";     // "" | "connecting" | "waiting_airplay" | "streaming"
    in-out property <int> stage-progress: 0;
    in-out property <string> stage-title: "";
    in-out property <string> stage-detail: "";
    in-out property <string> status-pill: "Siap";
    in-out property <string> status-pill-compact: "";
    in property <image> brand-logo-source: @image-url("assets/logo.png");
    in-out property <image> brand-logo-topbar: @image-url("assets/logo.png");
    in-out property <image> brand-logo-launchpad: @image-url("assets/logo.png");
    in-out property <string> device-model-name: "iPhone";
    in-out property <string> device-title: "Menghubungkan iPhone...";
    in-out property <string> device-subtitle: "Buka kunci, lalu tekan Mulai mirroring.";
    in-out property <string> device-pill-title: "Memindai perangkat iOS...";
    in-out property <string> device-pill-detail: "USB / Wi-Fi Auto-Discovery";
    in-out property <bool> device-ready: false;
    in-out property <bool> scanning: false;
    in-out property <string> selected-udid: "";
    in-out property <string> transport-tab: "wifi"; // "usb" | "wifi"
    in-out property <string> error-text: "";
    in-out property <string> connecting-detail: "";
    in-out property <[DeviceCardItem]> devices: [];
    in-out property <int> live-fps: 0;
    in-out property <string> live-res: "";
    in-out property <string> live-codec: "";
    in-out property <bool> is-airplay-standalone: false;
    in-out property <bool> is-airplay-session: false;

    // Card 2: Display, Aspect, Auto-Rotate, Stream Mode, 4-Edge Crop
    in-out property <string> fit-mode: "auto_fit";    // "auto_fit" | "edge_to_edge" | "original_ratio"
    in-out property <string> device-profile: "auto";  // "auto" | "iphone" | "ipad"
    in-out property <bool> auto-rotate: false;
    in-out property <string> stream-mode: "auto";     // "auto" | "airplay"
    in-out property <int> crop-top: 0;
    in-out property <int> crop-bottom: 0;
    in-out property <int> crop-left: 0;
    in-out property <int> crop-right: 0;

    // Card 3: Audio PC (WASAPI Bridge, AirPlay & Bluetooth A2DP fallback)
    in-out property <bool> audio-pc-active: true;
    in-out property <bool> audio-muted: false;
    in-out property <bool> airplay-audio-active: false;
    in-out property <bool> bt-audio-active: false;
    in-out property <bool> audio-live-active: false;
    in-out property <string> audio-live-state: "standby"; // active|connecting|muted|device|standby|error
    in-out property <int> airplay-volume: 100;
    in-out property <string> airplay-buffer: "normal"; // "low" | "normal" | "high"
    in-out property <bool> airplay-lip-sync: true;
    in-out property <int> airplay-lip-sync-ms: 0;      // -100..+100 ms
    in-out property <string> airplay-audio-telemetry: "Standby";
    in-out property <string> audio-status-banner: "Audio PC Siap (Otomatis aktif saat mirroring)";

    // Card 4 & 5: Trackpad Speed, Keyboard, Clipboard, iOS 27 Shortcut Bridge
    in-out property <int> trackpad-speed: 100;         // 30..200%
    in-out property <bool> keyboard-enabled: true;
    in-out property <bool> onscreen-kb-active: false;
    in-out property <bool> cross-platform-shortcuts: true;
    in-out property <bool> paste-pc-clipboard: true;
    in-out property <string> pc-lan-ip: "127.0.0.1";
    in-out property <string> shortcut-bridge-url: "http://127.0.0.1:8765/c?u=";
    in-out property <string> clipboard-feedback: "";

    // Card 6: Privacy, Stealth, Auto-Unlock PIN, Hide Tray
    in-out property <bool> stealth-active: false;
    in-out property <bool> pin-saved: false;
    in-out property <bool> pin-editing: false;
    in-out property <string> unlock-pin-input: "";

    // Card 7: Wi-Fi & Mirroring Control
    in-out property <string> wifi-status-text: "Siap memindai Wi-Fi iPhone di LAN.";

    // Card 8 & 9: 5-Point Diagnostics, AMFI, Repair Driver, OTA Updater, & Anti-Blank Recovery
    in-out property <[DiagRow]> diagnostics: [];
    in-out property <bool> auto-check-update: true;
    in-out property <string> update-channel: "stable"; // "stable" | "beta"
    in-out property <string> update-status-text: "iPhone Link v5.0.2 (Native Rust)";
    in-out property <bool> update-available: false;
    in-out property <string> latest-version: "5.0.2";
    in-out property <string> update-release-url: "";
    in-out property <string> update-download-url: "";
    in-out property <string> diag-feedback-text: "";
    in-out property <bool> diag-feedback-ok: true;
    in-out property <bool> anti-blank-visible: false;
    in-out property <string> anti-blank-reason: "";
    in-out property <string> anti-blank-title: "";
    in-out property <string> anti-blank-detail: "";

    // Action button feedback states (0=idle, 1=busy, 2=ok emerald, 3=error crimson, auto-resets 1.8s)
    in-out property <int> fb-crop-state: 0;
    in-out property <string> fb-crop-text: "";
    in-out property <int> fb-speed-state: 0;
    in-out property <string> fb-speed-text: "";
    in-out property <int> fb-paste-state: 0;
    in-out property <string> fb-paste-text: "";
    in-out property <int> fb-ocr-state: 0;
    in-out property <string> fb-ocr-text: "";
    in-out property <int> fb-grab-state: 0;
    in-out property <string> fb-grab-text: "";
    in-out property <int> fb-cache-state: 0;
    in-out property <string> fb-cache-text: "";
    in-out property <int> fb-wake-state: 0;
    in-out property <string> fb-wake-text: "";
    in-out property <int> fb-lock-state: 0;
    in-out property <string> fb-lock-text: "";
    in-out property <int> fb-stealth-state: 0;
    in-out property <string> fb-stealth-text: "";
    in-out property <int> fb-pin-state: 0;
    in-out property <string> fb-pin-text: "";
    in-out property <int> fb-wipe-state: 0;
    in-out property <string> fb-wipe-text: "";
    in-out property <int> fb-diag-copy-state: 0;
    in-out property <string> fb-diag-copy-text: "";

    // Computed translucent Win11 Acrylic glass palette (Dark Smoky + Light Milky Crystal)
    property <color> glass-shell: root.dark-mode ? #0C101A38 : #F4F7FC6E;
    property <color> glass-card: root.dark-mode ? #FFFFFF14 : #FFFFFF7D;
    property <color> text-primary: root.dark-mode ? #F8FAFC : #0F172A;
    property <color> text-muted: root.dark-mode ? #CBD5E1 : #1E293B;
    property <color> surface-chrome: root.dark-mode ? #0E131F48 : #F5F8FD68;
    property <color> border-chrome: root.dark-mode ? #FFFFFF29 : #FFFFFFD9;
    property <color> seg-track: root.dark-mode ? #080C144A : #0F172A16;
    property <color> sub-surface: root.dark-mode ? #FFFFFF10 : #FFFFFF59;
    property <bool> is-streaming-or-starting: root.phase == "running" || root.phase == "starting";
    property <bool> is-airplay-waiting: root.stage == "waiting_airplay";
    property <bool> is-airplay-waiting-frame: root.is-airplay-session && root.stage == "waiting_frame";
    property <float> eff-standby-op: root.anti-blank-visible ? 0.0
        : (root.transition-active ? clamp(root.standby-opacity, 0.0, 1.0)
            : ((root.phase != "running" && root.phase != "starting") ? 1.0 : 0.0));
    property <float> eff-sequoia-op: root.anti-blank-visible ? 0.0
        : (root.transition-active ? clamp(root.sequoia-opacity, 0.0, 1.0)
            : ((root.is-airplay-waiting || root.phase == "starting" || (root.phase == "running" && !root.first-frame-ready)) ? 1.0 : 0.0));
    property <float> eff-sequoia-text-op: root.anti-blank-visible ? 0.0
        : (root.transition-active ? clamp(root.sequoia-text-opacity, 0.0, 1.0) : root.eff-sequoia-op);
    property <bool> is-en: root.lang-en;
    property <bool> topbar-wide: root.drawer-open || root.is-landscape || root.is-fullscreen || root.width >= 500px;

    // Preserved & expanded callbacks wired to src/native_ui.rs
    callback minimize-window();
    callback toggle-fullscreen();
    callback close-window();
    callback hide-to-tray();
    callback toggle-drawer();
    callback cycle-rotation();
    callback toggle-landscape();
    callback toggle-audio-mute();
    callback scan-devices();
    callback select-device(string);
    callback set-transport(string);
    callback start-mirror();
    callback stop-mirror();
    callback restart-mirror();
    callback clear-error();
    callback pin-focus-changed(bool);
    callback pin-text-edited(string);
    callback open-icloud-shortcut();
    callback copy-siri-prompt();

    callback nav-swipe-back();
    callback nav-home();
    callback nav-recent();
    callback nav-swipe-right();

    callback toggle-theme();
    callback set-theme(bool);
    callback set-lang-en(bool);
    callback set-fit-mode(string);
    callback set-device-profile(string);
    callback reset-window-size();
    callback set-auto-rotate(bool);
    callback set-stream-mode(string);
    callback set-crop-edge(string, int);
    callback reset-crop();
    callback save-crop();

    callback set-audio-routing(string);
    callback pair-bluetooth-audio();
    callback set-airplay-volume(int);
    callback set-airplay-buffer(string);
    callback set-airplay-lip-sync(bool);
    callback set-airplay-lip-sync-ms(int);

    callback set-trackpad-speed(int);
    callback save-trackpad-speed();
    callback set-cross-platform-shortcuts(bool);
    callback set-paste-pc-clipboard(bool);
    callback paste-to-iphone();
    callback copy-ocr-text();
    callback grab-link-action();
    callback clear-ocr-cache();
    callback toggle-onscreen-keyboard();
    callback copy-shortcut-url();
    callback open-external-url(string);
    callback switch-to-airplay-h264();
    callback open-hevc-install-action();
    callback open-update-release();

    callback wake-unlock();
    callback lock-screen();
    callback toggle-stealth();
    callback save-unlock-pin(string);
    callback clear-unlock-pin();
    callback wipe-privacy-data();
    callback hardware-button(string);

    callback scan-wifi();
    callback pair-wifi();
    callback refresh-diagnostics();
    callback unlock-developer-mode();
    callback repair-driver();
    callback copy-diagnostic-log();
    callback set-auto-check-update(bool);
    callback set-update-channel(string);
    callback check-updates();

    callback key-shortcut-pressed(string, bool, bool, bool);

    FocusScope {
        width: 100%;
        height: 100%;

        key-pressed(ev) => {
            if (!root.pin-editing && (ev.modifiers.control || ev.modifiers.alt)) {
                root.key-shortcut-pressed(ev.text, ev.modifiers.control, ev.modifiers.alt, ev.modifiers.shift);
                return accept;
            }
            if (!root.pin-editing && root.phase == "running") {
                root.key-shortcut-pressed(ev.text, ev.modifiers.control, ev.modifiers.alt, ev.modifiers.shift);
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            x: 0px;
            y: 0px;
            width: 100%;
            height: 100%;
            spacing: 0px;

            // =========================================================================
            // TOP BAR (38px — Non-overlapping icons, isolated drag spacer, zero emoji)
            // =========================================================================
            top-bar := Rectangle {
                height: 38px;
                background: root.surface-chrome;
                animate background { duration: 180ms; easing: ease-in-out; }

                Rectangle {
                    x: 0px;
                    y: parent.height - 1px;
                    width: 100%;
                    height: 1px;
                    background: root.border-chrome;
                }

                HorizontalLayout {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    padding-left: 5px;
                    padding-right: 4px;
                    spacing: 2px;
                    alignment: stretch;

                    // Left Identity + Compact Status Capsule
                    HorizontalLayout {
                        spacing: 4px;
                        horizontal-stretch: 0;

                        Rectangle {
                            y: (parent.height - self.height) / 2;
                            width: 20px;
                            height: 20px;
                            background: transparent;
                            Image {
                                source: root.brand-logo-topbar;
                                width: 20px;
                                height: 20px;
                                image-fit: contain;
                            }
                        }

                        if root.topbar-wide : Text {
                            text: "iPhone Link";
                            color: root.text-primary;
                            font-size: 12px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }

                        Rectangle {
                            y: (parent.height - self.height) / 2;
                            height: 22px;
                            max-width: root.topbar-wide ? 220px
                                : (root.is-streaming-or-starting ? (root.auto-rotate ? 84px : 108px) : (root.auto-rotate ? 112px : 142px));
                            border-radius: 11px;
                            border-width: 1px;
                            border-color: (root.phase == "running" && root.first-frame-ready) ? #10B981AA
                                : root.is-streaming-or-starting ? #38BDF899
                                : root.device-ready ? #10B98188
                                : (root.dark-mode ? #FFFFFF29 : #0F172A24);
                            background: (root.phase == "running" && root.first-frame-ready) ? (root.dark-mode ? #064E3B77 : #D1FAE5CC)
                                : root.is-streaming-or-starting ? (root.dark-mode ? #0C4A6E77 : #E0F2FECC)
                                : root.device-ready ? (root.dark-mode ? #064E3B44 : #DCFCE7CC)
                                : (root.dark-mode ? #FFFFFF14 : #FFFFFFA6);

                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 7px;
                                spacing: 4px;
                                Rectangle {
                                    y: (parent.height - self.height) / 2;
                                    width: 6px;
                                    height: 6px;
                                    border-radius: 3px;
                                    background: (root.phase == "running" && root.first-frame-ready) ? #10B981
                                        : root.is-streaming-or-starting ? #38BDF8
                                        : root.device-ready ? #22C55E
                                        : #94A3B8;
                                }
                                Text {
                                    text: (!root.topbar-wide && root.status-pill-compact != "") ? root.status-pill-compact : root.status-pill;
                                    color: (root.phase == "running" && root.first-frame-ready) ? (root.dark-mode ? #A7F3D0 : #065F46)
                                        : root.is-streaming-or-starting ? (root.dark-mode ? #BAE6FD : #0369A1)
                                        : root.device-ready ? (root.dark-mode ? #86EFAC : #065F46)
                                        : root.text-primary;
                                    font-size: 10.5px;
                                    font-weight: 500;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }
                        }
                    }

                    // Inert Middle Spacer — Win32 WM_NCHITTEST HTCAPTION handles native drag cleanly (zero TouchArea capture!)
                    Rectangle {
                        horizontal-stretch: 1;
                        background: transparent;
                    }

                    // Right Control Cluster (Fluent SVG icons only, 6 standby / 8 streaming, 0px collision at 346px)
                    HorizontalLayout {
                        spacing: 2px;
                        horizontal-stretch: 0;
                        property <length> bsize: !root.topbar-wide ? (root.is-streaming-or-starting ? 21px : 23px) : (root.is-streaming-or-starting ? 24px : 25px);
                        property <length> bicon: (!root.topbar-wide && root.is-streaming-or-starting) ? 12px : 13px;

                        if root.is-streaming-or-starting : TopIconBtn {
                            y: (parent.height - self.height) / 2;
                            btn-size: bsize;
                            icon-px: bicon;
                            icon-name: "restart";
                            dark-mode: root.dark-mode;
                            clicked => { root.restart-mirror(); }
                        }

                        if root.is-streaming-or-starting : Rectangle {
                            y: (parent.height - self.height) / 2;
                            width: root.topbar-wide ? 56px : bsize;
                            height: bsize;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: stop-ta.has-hover ? #FCA5A5 : #F87171AA;
                            background: stop-ta.has-hover ? #EF4444 : #DC2626;
                            animate width { duration: 150ms; easing: cubic-bezier(0.16, 1.0, 0.3, 1.0); }
                            animate background { duration: 150ms; easing: cubic-bezier(0.16, 1.0, 0.3, 1.0); }
                            HorizontalLayout {
                                alignment: center;
                                spacing: 4px;
                                FluentIcon {
                                    y: (parent.height - self.height) / 2;
                                    name: "stop";
                                    icon-size: 10px;
                                    icon-color: #FFFFFF;
                                }
                                if root.topbar-wide : Text {
                                    text: "Stop";
                                    color: #FFFFFF;
                                    font-size: 10.5px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                            }
                            stop-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.stop-mirror(); }
                            }
                        }

                        TopIconBtn {
                            y: (parent.height - self.height) / 2;
                            btn-size: bsize;
                            icon-px: bicon;
                            icon-name: (root.audio-live-state == "muted" || root.audio-live-state == "device" || root.audio-live-state == "error") ? "audio-off" : "audio-on";
                            accent-green: root.audio-live-active;
                            active: root.audio-live-state == "connecting";
                            dark-mode: root.dark-mode;
                            clicked => { root.toggle-audio-mute(); }
                        }

                        TopIconBtn {
                            y: (parent.height - self.height) / 2;
                            btn-size: bsize;
                            icon-px: bicon;
                            icon-name: "settings";
                            active: root.drawer-open;
                            dark-mode: root.dark-mode;
                            clicked => { root.toggle-drawer(); }
                        }

                        // Rotate / Dynamic 2-Layer Nested [AUTO] Capsule
                        Rectangle {
                            y: (parent.height - self.height) / 2;
                            width: root.auto-rotate ? (!root.topbar-wide ? 58px : 64px) : bsize;
                            height: bsize;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: (root.is-landscape || root.auto-rotate)
                                ? (root.dark-mode ? #60A5FA73 : #0066CC66)
                                : (root.dark-mode ? (rot-ta.has-hover ? #FFFFFF44 : #FFFFFF24) : (rot-ta.has-hover ? #0F172A4D : #0F172A24));
                            background: (root.is-landscape || root.auto-rotate)
                                ? (root.dark-mode ? (rot-ta.has-hover ? #0EA5E938 : #007AFF24) : (rot-ta.has-hover ? #0066CC24 : #0066CC14))
                                : (root.dark-mode ? (rot-ta.has-hover ? #FFFFFF24 : #FFFFFF12) : (rot-ta.has-hover ? #FFFFFFCC : #FFFFFF7A));
                            animate width { duration: 160ms; easing: cubic-bezier(0.16, 1.0, 0.3, 1.0); }
                            animate background { duration: 150ms; easing: cubic-bezier(0.16, 1.0, 0.3, 1.0); }
                            HorizontalLayout {
                                alignment: center;
                                spacing: 3px;
                                padding-left: 3px;
                                padding-right: 3px;
                                FluentIcon {
                                    y: (parent.height - self.height) / 2;
                                    name: "rotate";
                                    icon-size: root.auto-rotate ? 11.5px : bicon;
                                    icon-color: root.is-landscape ? #38BDF8 : (root.dark-mode ? #FFFFFF : #1F2937);
                                }
                                if root.auto-rotate : Rectangle {
                                    y: (parent.height - self.height) / 2;
                                    height: 14px;
                                    border-radius: 4px;
                                    border-width: 1px;
                                    border-color: root.dark-mode ? #60A5FA73 : #0066CC66;
                                    background: root.dark-mode ? #007AFF47 : #0066CC2E;
                                    HorizontalLayout {
                                        padding-left: 3px;
                                        padding-right: 3px;
                                        alignment: center;
                                        Text {
                                            text: "AUTO";
                                            color: root.dark-mode ? #60A5FA : #0066CC;
                                            font-size: 8.5px;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                            rot-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.toggle-landscape(); }
                            }
                        }

                        TopIconBtn {
                            y: (parent.height - self.height) / 2;
                            btn-size: bsize;
                            icon-px: bicon;
                            icon-name: root.is-fullscreen ? "fullscreen-exit" : "fullscreen";
                            active: root.is-fullscreen;
                            dark-mode: root.dark-mode;
                            clicked => { root.toggle-fullscreen(); }
                        }

                        TopIconBtn {
                            y: (parent.height - self.height) / 2;
                            btn-size: bsize;
                            icon-px: bicon;
                            icon-name: "minimize";
                            caption-btn: true;
                            dark-mode: root.dark-mode;
                            clicked => { root.minimize-window(); }
                        }

                        TopIconBtn {
                            y: (parent.height - self.height) / 2;
                            btn-size: bsize;
                            icon-px: bicon;
                            icon-name: "close";
                            caption-btn: true;
                            close-btn: true;
                            dark-mode: root.dark-mode;
                            clicked => { root.close-window(); }
                        }
                    }
                }
            }

            // =========================================================================
            // MAIN BODY SPLIT: LEFT STAGE + QUICK NAV  |  RIGHT 8-CARD SIDE DRAWER
            // =========================================================================
            HorizontalLayout {
                vertical-stretch: 1;
                spacing: 0px;

                // LEFT STAGE + BOTTOM QUICK NAV
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 0px;

                    // CENTER STAGE CONTAINER
                    stage-slot := Rectangle {
                        vertical-stretch: 1;
                        background: transparent;

                        property <length> hole-rel-x: clamp(root.video-hole-x, 0px, self.width);
                        property <length> hole-rel-y: clamp(root.video-hole-y - 38px, 0px, self.height);
                        property <length> hole-rel-w: min(root.video-hole-w, max(0px, self.width - self.hole-rel-x));
                        property <length> hole-rel-h: min(root.video-hole-h, max(0px, self.height - self.hole-rel-y));
                        property <bool> fs-portrait: root.is-fullscreen && !root.is-landscape;
                        property <float> seq-aspect: root.device-profile == "ipad" ? 0.73 : 0.46133;
                        property <bool> use-hole-box: root.video-layer-active && stage-slot.hole-rel-w > 24px;
                        property <length> seq-w: !stage-slot.fs-portrait ? stage-slot.width
                            : (stage-slot.use-hole-box ? stage-slot.hole-rel-w : min(stage-slot.width, stage-slot.height * stage-slot.seq-aspect));
                        property <length> seq-h: !stage-slot.fs-portrait ? stage-slot.height
                            : (stage-slot.use-hole-box ? stage-slot.hole-rel-h : stage-slot.height);
                        property <length> seq-x: !stage-slot.fs-portrait ? 0px
                            : (stage-slot.use-hole-box ? stage-slot.hole-rel-x : (stage-slot.width - stage-slot.seq-w) / 2);
                        property <length> seq-y: !stage-slot.fs-portrait ? 0px
                            : (stage-slot.use-hole-box ? stage-slot.hole-rel-y : 0px);
                        property <float> wings-op: root.video-layer-active ? 1.0
                            : (stage-slot.fs-portrait ? max(root.eff-sequoia-op, root.reveal-blur-visible ? root.reveal-blur-opacity : 0.0) : 0.0);
                        property <bool> wings-active: !root.anti-blank-visible && stage-slot.wings-op > 0.005;

                        // FULLSCREEN / LETTERBOX BLUR WINGS AROUND TRANSPARENT LAYER-0 VIDEO HOLE & SEQUOIA BOX
                        if stage-slot.wings-active && stage-slot.seq-x > 0px : Rectangle {
                            x: 0px;
                            y: 0px;
                            width: stage-slot.seq-x;
                            height: parent.height;
                            opacity: stage-slot.wings-op;
                            background: root.glass-shell;
                            animate background { duration: 180ms; easing: ease-in-out; }
                        }
                        if stage-slot.wings-active && (stage-slot.width - stage-slot.seq-x - stage-slot.seq-w) > 0px : Rectangle {
                            x: stage-slot.seq-x + stage-slot.seq-w;
                            y: 0px;
                            width: max(0px, parent.width - self.x);
                            height: parent.height;
                            opacity: stage-slot.wings-op;
                            background: root.glass-shell;
                            animate background { duration: 180ms; easing: ease-in-out; }
                        }
                        if root.video-layer-active && stage-slot.hole-rel-y > 0px : Rectangle {
                            x: stage-slot.hole-rel-x;
                            y: 0px;
                            width: stage-slot.hole-rel-w;
                            height: stage-slot.hole-rel-y;
                            background: root.glass-shell;
                            animate background { duration: 180ms; easing: ease-in-out; }
                        }
                        if root.video-layer-active && (stage-slot.height - stage-slot.hole-rel-y - stage-slot.hole-rel-h) > 0px : Rectangle {
                            x: stage-slot.hole-rel-x;
                            y: stage-slot.hole-rel-y + stage-slot.hole-rel-h;
                            width: stage-slot.hole-rel-w;
                            height: max(0px, parent.height - self.y);
                            background: root.glass-shell;
                            animate background { duration: 180ms; easing: ease-in-out; }
                        }
                        // Specular 1px glass edge framing Fullscreen Portrait wings strictly OUTSIDE seq-box
                        if stage-slot.wings-active && stage-slot.seq-x > 2px : Rectangle {
                            x: stage-slot.seq-x - 1px;
                            y: stage-slot.seq-y;
                            width: 1px;
                            height: stage-slot.seq-h;
                            opacity: stage-slot.wings-op;
                            background: root.border-chrome;
                        }
                        if stage-slot.wings-active && stage-slot.seq-x > 2px && (stage-slot.width - stage-slot.seq-x - stage-slot.seq-w) > 2px : Rectangle {
                            x: stage-slot.seq-x + stage-slot.seq-w;
                            y: stage-slot.seq-y;
                            width: 1px;
                            height: stage-slot.seq-h;
                            opacity: stage-slot.wings-op;
                            background: root.border-chrome;
                        }

                        // TRUE SEQUOIA BLUR-TO-SHARP FIRST/LAST FRAME DISSOLVE LAYER (360ms enter / 280ms exit)
                        if !root.anti-blank-visible && root.reveal-blur-visible && root.reveal-blur-opacity > 0.005 : Rectangle {
                            x: stage-slot.seq-x;
                            y: stage-slot.seq-y;
                            width: stage-slot.seq-w;
                            height: stage-slot.seq-h;
                            clip: true;
                            background: transparent;
                            opacity: root.reveal-blur-opacity;
                            Image {
                                x: 0px;
                                y: 0px;
                                width: 100%;
                                height: 100%;
                                source: root.reveal-blur-image;
                                image-fit: cover;
                            }
                        }

                        // PRIORITY #2/#3: SEQUOIA 1:1 CLEAN CANVAS (HEVC Connecting & AirPlay Waiting — Stop via Top Bar Only)
                        if !root.anti-blank-visible && (root.eff-sequoia-op > 0.005 || root.eff-sequoia-text-op > 0.005) : sequoia-reveal := Rectangle {
                            x: stage-slot.seq-x;
                            y: stage-slot.seq-y;
                            width: stage-slot.seq-w;
                            height: stage-slot.seq-h;
                            clip: true;
                            background: transparent;

                            if root.eff-sequoia-op > 0.005 : Rectangle {
                                x: 0px;
                                y: 0px;
                                width: 100%;
                                height: 100%;
                                opacity: root.eff-sequoia-op;
                                background: transparent;

                                if root.has-last-frame-blur : Image {
                                    x: 0px;
                                    y: 0px;
                                    width: 100%;
                                    height: 100%;
                                    source: root.last-frame-blur-image;
                                    image-fit: cover;
                                }
                                if root.has-last-frame-blur : Rectangle {
                                    x: 0px;
                                    y: 0px;
                                    width: 100%;
                                    height: 100%;
                                    background: root.dark-mode ? #040E165C : #0F172A52;
                                }
                                if !root.has-last-frame-blur : Rectangle {
                                    x: 0px;
                                    y: 0px;
                                    width: 100%;
                                    height: 100%;
                                    background: root.glass-shell;
                                    animate background { duration: 180ms; easing: ease-in-out; }
                                }
                            }

                            if root.eff-sequoia-text-op > 0.005 : Rectangle {
                                x: 24px;
                                y: (parent.height - self.height) / 2;
                                width: parent.width - 48px;
                                height: seq-text-col.preferred-height;
                                background: transparent;
                                opacity: root.eff-sequoia-text-op;

                                seq-text-col := VerticalLayout {
                                    property <color> seq-fg: (root.has-last-frame-blur || root.dark-mode) ? #F8FAFC : #0F172A;
                                    property <color> seq-kicker-fg: (root.has-last-frame-blur || root.dark-mode) ? #E2E8F0 : #334155;

                                    width: 100%;
                                    spacing: (root.is-airplay-waiting || root.is-airplay-waiting-frame) ? 6px : 4px;
                                    alignment: center;

                                    if !root.is-airplay-waiting && !root.is-airplay-waiting-frame : Text {
                                        text: root.is-en ? "Connecting to" : "Menyambungkan ke";
                                        color: parent.seq-kicker-fg;
                                        font-size: 13.5px;
                                        font-weight: 500;
                                        horizontal-alignment: center;
                                    }

                                    if !root.is-airplay-waiting && !root.is-airplay-waiting-frame : Text {
                                        text: root.device-model-name != "" ? root.device-model-name : "iPhone";
                                        color: parent.seq-fg;
                                        font-size: 21px;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                        wrap: word-wrap;
                                    }

                                    if !root.is-airplay-waiting && !root.is-airplay-waiting-frame && root.connecting-detail != "" : Text {
                                        text: root.connecting-detail;
                                        color: parent.seq-kicker-fg;
                                        font-size: 11px;
                                        font-weight: 500;
                                        horizontal-alignment: center;
                                        wrap: word-wrap;
                                    }

                                    if root.is-airplay-waiting : Text {
                                        text: root.is-en
                                            ? "Open Control Center on iPhone → Screen Mirroring → select 'iPhone Link'"
                                            : "Buka Pusat Kontrol di iPhone → Pencerminan Layar → pilih 'iPhone Link'";
                                        color: parent.seq-kicker-fg;
                                        font-size: 13px;
                                        font-weight: 500;
                                        horizontal-alignment: center;
                                        wrap: word-wrap;
                                    }

                                    if root.is-airplay-waiting : Text {
                                        text: root.device-model-name != "" ? root.device-model-name : "iPhone";
                                        color: parent.seq-fg;
                                        font-size: 21px;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                        wrap: word-wrap;
                                    }

                                    if root.is-airplay-waiting : Text {
                                        text: root.is-en
                                            ? "View & Audio Only (No PC Control)"
                                            : "Tampilan & Audio Saja (Tanpa Kontrol PC)";
                                        color: parent.seq-kicker-fg;
                                        font-size: 10.5px;
                                        font-weight: 500;
                                        horizontal-alignment: center;
                                        wrap: word-wrap;
                                    }

                                    if root.is-airplay-waiting-frame : Text {
                                        text: root.is-en
                                            ? "Connected to AirPlay - Waiting for first frame..."
                                            : "Tersambung ke AirPlay - Menunggu gambar pertama...";
                                        color: parent.seq-kicker-fg;
                                        font-size: 13px;
                                        font-weight: 500;
                                        horizontal-alignment: center;
                                        wrap: word-wrap;
                                    }

                                    if root.is-airplay-waiting-frame : Text {
                                        text: root.device-model-name != "" ? root.device-model-name : "iPhone";
                                        color: parent.seq-fg;
                                        font-size: 21px;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                        wrap: word-wrap;
                                    }
                                }
                            }
                        }
                        // End sequoia-reveal (unified HEVC & waiting_airplay; Stop via Top Bar)

                        // PRIORITY #1: ANTI-BLANK DIAGNOSTIC OVERLAY (Win10 Missing HEVC / Media Feature Pack / Zero-Frame Fallback)
                        if root.anti-blank-visible : Rectangle {
                            width: 100%;
                            height: 100%;
                            background: root.dark-mode ? #0C101AD0 : #F4F7FCD8;
                            animate background { duration: 180ms; easing: ease-in-out; }

                            Rectangle {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                width: min(parent.width - 28px, 316px);
                                height: ab-card-col.preferred-height + 32px;
                                border-radius: 18px;
                                border-width: 1px;
                                border-color: #F59E0B77;
                                background: root.dark-mode ? #141926EB : #FFFFFFEA;

                                ab-card-col := VerticalLayout {
                                    x: 18px;
                                    y: 16px;
                                    width: parent.width - 36px;
                                    spacing: 10px;
                                    alignment: center;

                                    Rectangle {
                                        x: (parent.width - self.width) / 2;
                                        width: 46px;
                                        height: 46px;
                                        border-radius: 14px;
                                        background: #F59E0B26;
                                        border-width: 1px;
                                        border-color: #F59E0B88;
                                        FluentIcon {
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            name: "warning";
                                            icon-size: 22px;
                                            icon-color: root.dark-mode ? #FBBF24 : #D97706;
                                        }
                                    }

                                    Text {
                                        text: root.anti-blank-title != ""
                                            ? root.anti-blank-title
                                            : (root.anti-blank-reason == "media_feature_pack_missing"
                                                ? (root.is-en ? "Media Feature Pack Required" : "Media Feature Pack Diperlukan")
                                                : (root.is-en ? "HEVC Codec / Video Frame Needed" : "Codec HEVC / Frame Belum Masuk"));
                                        color: root.text-primary;
                                        font-size: 15.5px;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                        wrap: word-wrap;
                                    }

                                    Text {
                                        text: root.anti-blank-detail != ""
                                            ? root.anti-blank-detail
                                            : (root.anti-blank-reason == "media_feature_pack_missing"
                                                ? (root.is-en ? "Windows N/KN requires Media Feature Pack in Optional Features, then restart Windows." : "Windows Edisi N/KN memerlukan Media Feature Pack lewat Optional Features, lalu restart Windows.")
                                                : (root.is-en ? "Your PC does not have an HEVC decoder yet or frames timed out. Switch to AirPlay H.264 (works on all Windows 10/11 PCs) or install Free HEVC." : "PC belum memiliki dekoder HEVC atau frame video belum tiba. Pindah ke Mode AirPlay H.264 (jalan di semua PC Windows 10/11) atau pasang HEVC Gratis."));
                                        color: root.text-muted;
                                        font-size: 11px;
                                        horizontal-alignment: center;
                                        wrap: word-wrap;
                                    }

                                    if root.anti-blank-reason != "media_feature_pack_missing" : ActionBtn {
                                        label: root.anti-blank-reason == "ios_below_27"
                                            ? (root.is-en ? "Switch to AirPlay Mode" : "Lanjut ke Mode AirPlay")
                                            : (root.anti-blank-reason == "hevc_mft_missing"
                                                ? (root.is-en ? "Use AirPlay Temporarily" : "Gunakan AirPlay Sementara")
                                                : (root.is-en ? "Switch to AirPlay H.264" : "Pindah ke AirPlay H.264"));
                                        icon-name: "monitor";
                                        primary: true;
                                        dark-mode: root.dark-mode;
                                        clicked => { root.switch-to-airplay-h264(); }
                                    }

                                    if root.anti-blank-reason != "ios_below_27" : ActionBtn {
                                        label: root.anti-blank-reason == "media_feature_pack_missing"
                                            ? (root.is-en ? "Open Optional Features" : "Buka Optional Features")
                                            : (root.is-en ? "Install Free HEVC (USB 60fps)" : "Pasang HEVC Gratis (USB 60fps)");
                                        icon-name: "sparkles";
                                        emerald: true;
                                        dark-mode: root.dark-mode;
                                        clicked => { root.open-hevc-install-action(); }
                                    }

                                    ActionBtn {
                                        label: root.is-en ? "Cancel" : "Batal";
                                        icon-name: "close";
                                        danger: true;
                                        dark-mode: root.dark-mode;
                                        clicked => { root.stop-mirror(); }
                                    }
                                }
                            }
                        }

                        // IDLE LAUNCHPAD STAGE (Frosted translucent Acrylic glass shell + smooth Sequoia cross-fade)
                        if !root.anti-blank-visible && root.eff-standby-op > 0.005 : standby-stage := Rectangle {
                            width: 100%;
                            height: 100%;
                            opacity: root.eff-standby-op;
                            background: root.glass-shell;
                            animate background { duration: 180ms; easing: ease-in-out; }

                            lp-flick := Flickable {
                            width: 100%;
                            height: 100%;
                            content-width: self.width;
                            content-height: max(self.height, lp-col.preferred-height);
                            property <bool> compact: root.is-landscape || stage-slot.height < 560px;

                            lp-col := VerticalLayout {
                                x: 0px;
                                y: 0px;
                                width: parent.width;
                                height: max(parent.height, self.preferred-height);
                                alignment: center;
                                padding-top: lp-flick.compact ? 6px : 12px;
                                padding-bottom: lp-flick.compact ? 6px : 12px;
                                padding-left: 16px;
                                padding-right: 16px;
                                spacing: lp-flick.compact ? 5px : 9px;

                                // Hero App Logo + Ambient Glow (hidden in compact 468px Landscape so CTA fits unclipped)
                                if !lp-flick.compact : Rectangle {
                                    x: (parent.width - self.width) / 2;
                                    width: 64px;
                                    height: 64px;
                                    background: transparent;

                                    Rectangle {
                                        x: 0px;
                                        y: 0px;
                                        width: 64px;
                                        height: 64px;
                                        border-radius: 20px;
                                        background: @radial-gradient(circle, #0EA5E955 0%, #0EA5E900 72%);
                                    }

                                    Image {
                                        x: 6px;
                                        y: 6px;
                                        width: 52px;
                                        height: 52px;
                                        source: root.brand-logo-launchpad;
                                        image-fit: contain;
                                    }
                                }

                                // Hero Title & Subtitle
                                VerticalLayout {
                                    spacing: lp-flick.compact ? 1px : 3px;
                                    Text {
                                        text: root.device-title;
                                        color: root.text-primary;
                                        font-size: lp-flick.compact ? 15px : 17px;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                        wrap: word-wrap;
                                    }
                                    Text {
                                        text: root.device-subtitle;
                                        color: root.text-muted;
                                        font-size: lp-flick.compact ? 10.5px : 11px;
                                        horizontal-alignment: center;
                                        wrap: word-wrap;
                                    }
                                }

                                // Device Status Capsule Pill
                                Rectangle {
                                    x: (parent.width - self.width) / 2;
                                    width: min(parent.width - 6px, 310px);
                                    height: lp-flick.compact ? 42px : 50px;
                                    border-radius: lp-flick.compact ? 21px : 25px;
                                    border-width: 1px;
                                    border-color: root.border-chrome;
                                    background: root.glass-card;
                                    animate background { duration: 180ms; easing: ease-in-out; }

                                    HorizontalLayout {
                                        x: 14px;
                                        y: 0px;
                                        width: parent.width - 24px;
                                        height: parent.height;
                                        spacing: 10px;

                                        Rectangle {
                                            y: (parent.height - self.height) / 2;
                                            width: 9px;
                                            height: 9px;
                                            border-radius: 4.5px;
                                            background: root.device-ready ? #22C55E : #94A3B8;
                                        }

                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            alignment: center;
                                            spacing: 1px;
                                            Text {
                                                text: root.device-pill-title;
                                                color: root.text-primary;
                                                font-size: 12px;
                                                font-weight: 600;
                                                overflow: elide;
                                            }
                                            Text {
                                                text: root.device-pill-detail;
                                                color: root.text-muted;
                                                font-size: 10.5px;
                                                overflow: elide;
                                            }
                                        }

                                        Rectangle {
                                            y: (parent.height - self.height) / 2;
                                            width: 30px;
                                            height: 30px;
                                            border-radius: 15px;
                                            border-width: 1px;
                                            border-color: root.dark-mode ? #FFFFFF29 : #0F172A24;
                                            background: ref-ta.has-hover
                                                ? (root.dark-mode ? #FFFFFF28 : #FFFFFFCC)
                                                : (root.dark-mode ? #FFFFFF14 : #FFFFFF99);
                                            FluentIcon {
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                                name: "refresh";
                                                icon-size: 14px;
                                                icon-color: root.text-primary;
                                            }
                                            ref-ta := TouchArea {
                                                enabled: !root.is-streaming-or-starting;
                                                mouse-cursor: root.is-streaming-or-starting ? default : pointer;
                                                clicked => {
                                                    if (!root.is-streaming-or-starting) {
                                                        root.scan-devices();
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }

                                // Multi-iPhone Picker Card
                                Rectangle {
                                    x: (parent.width - self.width) / 2;
                                    width: min(parent.width - 6px, 310px);
                                    border-radius: 14px;
                                    border-width: 1px;
                                    border-color: root.border-chrome;
                                    background: root.glass-card;
                                    animate background { duration: 180ms; easing: ease-in-out; }

                                    VerticalLayout {
                                        padding: lp-flick.compact ? 7px : 9px;
                                        spacing: lp-flick.compact ? 4px : 6px;

                                        HorizontalLayout {
                                            padding-left: 2px;
                                            padding-right: 2px;
                                            Text {
                                                text: root.is-en ? "SELECT IPHONE" : "PILIH IPHONE";
                                                color: root.text-muted;
                                                font-size: 10px;
                                                font-weight: 700;
                                                vertical-alignment: center;
                                                horizontal-stretch: 1;
                                            }
                                            Rectangle {
                                                width: 22px;
                                                height: 18px;
                                                border-radius: 9px;
                                                background: root.dark-mode ? #1E3A5F : #DBEAFE;
                                                Text {
                                                    width: 100%;
                                                    height: 100%;
                                                    text: root.devices.length;
                                                    color: root.dark-mode ? #60A5FA : #1D4ED8;
                                                    font-size: 10.5px;
                                                    font-weight: 700;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }

                                        if root.devices.length == 0 : Rectangle {
                                            height: 42px;
                                            border-radius: 10px;
                                            border-width: 1px;
                                            border-color: root.dark-mode ? #FFFFFF24 : #0F172A1E;
                                            background: root.dark-mode ? #FFFFFF12 : #FFFFFF8A;
                                            Text {
                                                x: 10px;
                                                width: parent.width - 20px;
                                                height: parent.height;
                                                text: root.is-en
                                                    ? "No iPhone detected yet. Connect USB or tap Scan Wi-Fi."
                                                    : "Belum ada iPhone terdeteksi. Hubungkan USB atau klik Pindai Wi-Fi.";
                                                color: root.text-muted;
                                                font-size: 10.5px;
                                                vertical-alignment: center;
                                                wrap: word-wrap;
                                            }
                                        }

                                        for dev in root.devices : Rectangle {
                                            height: lp-flick.compact ? 36px : 44px;
                                            border-radius: 10px;
                                            border-width: 1px;
                                            border-color: dev.selected ? #2B84F6
                                                : (root.dark-mode ? #FFFFFF24 : #0F172A1E);
                                            background: dev.selected
                                                ? (root.dark-mode ? #1B6BFF3B : #DBEAFECC)
                                                : (dev-ta.has-hover
                                                    ? (root.dark-mode ? #FFFFFF22 : #FFFFFFCC)
                                                    : (root.dark-mode ? #FFFFFF12 : #FFFFFF99));

                                            HorizontalLayout {
                                                x: 10px;
                                                y: 0px;
                                                width: parent.width - 20px;
                                                height: parent.height;
                                                spacing: 9px;

                                                Rectangle {
                                                    y: (parent.height - self.height) / 2;
                                                    width: 8px;
                                                    height: 8px;
                                                    border-radius: 4px;
                                                    background: dev.online ? #22C55E : #9CA3AF;
                                                }

                                                VerticalLayout {
                                                    horizontal-stretch: 1;
                                                    alignment: center;
                                                    spacing: 1px;
                                                    Text {
                                                        text: dev.name;
                                                        color: root.text-primary;
                                                        font-size: 12px;
                                                        font-weight: 600;
                                                        overflow: elide;
                                                    }
                                                    Text {
                                                        text: dev.model;
                                                        color: dev.selected && dev.online
                                                            ? (root.dark-mode ? #7DD3FC : #0369A1)
                                                            : root.text-muted;
                                                        font-size: 10.5px;
                                                        overflow: elide;
                                                    }
                                                }

                                                if dev.selected : Rectangle {
                                                    y: (parent.height - self.height) / 2;
                                                    width: 20px;
                                                    height: 20px;
                                                    border-radius: 10px;
                                                    background: #1B6BFF;
                                                    FluentIcon {
                                                        x: 4px;
                                                        y: 4px;
                                                        name: "check";
                                                        icon-size: 12px;
                                                        icon-color: #FFFFFF;
                                                    }
                                                }
                                            }

                                            dev-ta := TouchArea {
                                                enabled: !root.is-streaming-or-starting;
                                                mouse-cursor: root.is-streaming-or-starting ? default : pointer;
                                                clicked => {
                                                    if (!root.is-streaming-or-starting) {
                                                        root.select-device(dev.udid);
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }

                                // Transport Segmented Pill (USB vs Wi-Fi)
                                Rectangle {
                                    x: (parent.width - self.width) / 2;
                                    width: min(parent.width - 24px, 266px);
                                    height: lp-flick.compact ? 30px : 34px;
                                    border-radius: lp-flick.compact ? 15px : 17px;
                                    border-width: 1px;
                                    border-color: root.dark-mode ? #FFFFFF24 : #0F172A1E;
                                    background: root.seg-track;

                                    HorizontalLayout {
                                        padding: 3px;
                                        spacing: 3px;
                                        SegPill {
                                            label: root.is-en ? "Cable (USB)" : "Kabel (USB)";
                                            icon-name: "usb";
                                            pill-height: lp-flick.compact ? 22px : 26px;
                                            active: root.transport-tab == "usb";
                                            dark-mode: root.dark-mode;
                                            clicked => {
                                                if (!root.is-streaming-or-starting) {
                                                    root.set-transport("usb");
                                                }
                                            }
                                        }
                                        SegPill {
                                            label: "Wi-Fi";
                                            icon-name: "wifi";
                                            pill-height: lp-flick.compact ? 22px : 26px;
                                            active: root.transport-tab == "wifi";
                                            dark-mode: root.dark-mode;
                                            clicked => {
                                                if (!root.is-streaming-or-starting) {
                                                    root.set-transport("wifi");
                                                }
                                            }
                                        }
                                    }
                                }

                                // Primary Start Mirroring Pill CTA (Clean Standby Stage — 1:1 Tahap 259)
                                Rectangle {
                                    x: (parent.width - self.width) / 2;
                                    width: min(parent.width - 48px, 224px);
                                    height: lp-flick.compact ? 36px : 42px;
                                    border-radius: lp-flick.compact ? 18px : 21px;
                                    border-width: 1px;
                                    border-color: #38BDF899;
                                    background: start-ta.has-hover
                                        ? @linear-gradient(90deg, #2576FF 0%, #19B4FB 100%)
                                        : @linear-gradient(90deg, #1B6BFF 0%, #0DA5F0 100%);

                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: 8px;
                                        FluentIcon {
                                            y: (parent.height - self.height) / 2;
                                            name: "play";
                                            icon-size: 13px;
                                            icon-color: #FFFFFF;
                                        }
                                        Text {
                                            text: root.is-en ? "Start mirroring" : "Mulai mirroring";
                                            color: #FFFFFF;
                                            font-size: 13.5px;
                                            font-weight: 600;
                                            vertical-alignment: center;
                                        }
                                    }
                                    start-ta := TouchArea {
                                        enabled: !root.is-streaming-or-starting;
                                        mouse-cursor: root.is-streaming-or-starting ? default : pointer;
                                        clicked => {
                                            if (!root.is-streaming-or-starting) {
                                                root.start-mirror();
                                            }
                                        }
                                    }
                                }

                                // Honest Error Banner (Zero Silent Failures + 1-Click Zero-PII Diagnostic Log Copy)
                                if root.error-text != "" : Rectangle {
                                    x: (parent.width - self.width) / 2;
                                    width: min(parent.width - 12px, 316px);
                                    border-radius: 11px;
                                    border-width: 1px;
                                    border-color: #EF4444AA;
                                    background: root.dark-mode ? #7F1D1D66 : #FEE2E2CC;

                                    VerticalLayout {
                                        padding: 10px;
                                        spacing: 7px;
                                        HorizontalLayout {
                                            spacing: 8px;
                                            FluentIcon {
                                                y: 2px;
                                                name: "warning";
                                                icon-size: 15px;
                                                icon-color: root.dark-mode ? #FCA5A5 : #B91C1C;
                                            }
                                            Text {
                                                horizontal-stretch: 1;
                                                text: root.error-text;
                                                color: root.dark-mode ? #FECACA : #991B1B;
                                                font-size: 11px;
                                                wrap: word-wrap;
                                            }
                                            Rectangle {
                                                width: 20px;
                                                height: 20px;
                                                border-radius: 5px;
                                                background: err-close-ta.has-hover ? #EF444433 : transparent;
                                                FluentIcon {
                                                    x: 4px;
                                                    y: 4px;
                                                    name: "close";
                                                    icon-size: 12px;
                                                    icon-color: root.dark-mode ? #FCA5A5 : #B91C1C;
                                                }
                                                err-close-ta := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => { root.clear-error(); }
                                                }
                                            }
                                        }
                                        ActionBtn {
                                            btn-height: 28px;
                                            label-font-px: 10.5px;
                                            label: root.is-en ? "Copy Diagnostic Log" : "Salin Log Diagnostik";
                                            icon-name: "copy";
                                            fb-state: root.fb-diag-copy-state;
                                            fb-label: root.fb-diag-copy-text;
                                            dark-mode: root.dark-mode;
                                            clicked => { root.copy-diagnostic-log(); }
                                        }
                                    }
                                }
                            }
                        }
                        }
                    }

                    // BOTTOM QUICK NAV BAR (44px — < Swipe | • Home | □ Recent | Swipe >)
                    quick-nav := Rectangle {
                        height: 44px;
                        background: root.surface-chrome;
                        animate background { duration: 180ms; easing: ease-in-out; }

                        Rectangle {
                            x: 0px;
                            y: 0px;
                            width: 100%;
                            height: 1px;
                            background: root.border-chrome;
                        }

                        HorizontalLayout {
                            x: 0px;
                            y: 1px;
                            width: parent.width;
                            height: parent.height - 1px;
                            padding-left: 8px;
                            padding-right: 8px;
                            padding-top: 6px;
                            padding-bottom: 6px;
                            spacing: 6px;

                            Rectangle {
                                horizontal-stretch: 1;
                                border-radius: 8px;
                                border-width: 1px;
                                border-color: q1-ta.pressed ? #1B6BFF : (root.dark-mode ? #FFFFFF26 : #0F172A1E);
                                background: q1-ta.pressed
                                    ? (root.dark-mode ? #1B6BFF44 : #DBEAFECC)
                                    : (q1-ta.has-hover
                                        ? (root.dark-mode ? #FFFFFF24 : #FFFFFFCC)
                                        : (root.dark-mode ? #FFFFFF14 : #FFFFFF8F));
                                animate background { duration: 150ms; easing: ease-out; }
                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 4px;
                                    FluentIcon {
                                        y: (parent.height - self.height) / 2;
                                        name: "chevron-left";
                                        icon-size: 12px;
                                        icon-color: root.text-primary;
                                    }
                                    Text {
                                        text: "Swipe";
                                        color: root.text-primary;
                                        font-size: 11px;
                                        font-weight: 500;
                                        vertical-alignment: center;
                                    }
                                }
                                q1-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.nav-swipe-back(); }
                                }
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                                border-radius: 8px;
                                border-width: 1px;
                                border-color: q2-ta.pressed ? #1B6BFF : (root.dark-mode ? #FFFFFF26 : #0F172A1E);
                                background: q2-ta.pressed
                                    ? (root.dark-mode ? #1B6BFF44 : #DBEAFECC)
                                    : (q2-ta.has-hover
                                        ? (root.dark-mode ? #FFFFFF24 : #FFFFFFCC)
                                        : (root.dark-mode ? #FFFFFF14 : #FFFFFF8F));
                                animate background { duration: 150ms; easing: ease-out; }
                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 5px;
                                    FluentIcon {
                                        y: (parent.height - self.height) / 2;
                                        name: "home-dot";
                                        icon-size: 9px;
                                        icon-color: root.text-primary;
                                    }
                                    Text {
                                        text: "Home";
                                        color: root.text-primary;
                                        font-size: 11px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                }
                                q2-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.nav-home(); }
                                }
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                                border-radius: 8px;
                                border-width: 1px;
                                border-color: q3-ta.pressed ? #1B6BFF : (root.dark-mode ? #FFFFFF26 : #0F172A1E);
                                background: q3-ta.pressed
                                    ? (root.dark-mode ? #1B6BFF44 : #DBEAFECC)
                                    : (q3-ta.has-hover
                                        ? (root.dark-mode ? #FFFFFF24 : #FFFFFFCC)
                                        : (root.dark-mode ? #FFFFFF14 : #FFFFFF8F));
                                animate background { duration: 150ms; easing: ease-out; }
                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 5px;
                                    FluentIcon {
                                        y: (parent.height - self.height) / 2;
                                        name: "recent";
                                        icon-size: 12px;
                                        icon-color: root.text-primary;
                                    }
                                    Text {
                                        text: "Recent";
                                        color: root.text-primary;
                                        font-size: 11px;
                                        font-weight: 500;
                                        vertical-alignment: center;
                                    }
                                }
                                q3-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.nav-recent(); }
                                }
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                                border-radius: 8px;
                                border-width: 1px;
                                border-color: q4-ta.pressed ? #1B6BFF : (root.dark-mode ? #FFFFFF26 : #0F172A1E);
                                background: q4-ta.pressed
                                    ? (root.dark-mode ? #1B6BFF44 : #DBEAFECC)
                                    : (q4-ta.has-hover
                                        ? (root.dark-mode ? #FFFFFF24 : #FFFFFFCC)
                                        : (root.dark-mode ? #FFFFFF14 : #FFFFFF8F));
                                animate background { duration: 150ms; easing: ease-out; }
                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 4px;
                                    Text {
                                        text: "Swipe";
                                        color: root.text-primary;
                                        font-size: 11px;
                                        font-weight: 500;
                                        vertical-alignment: center;
                                    }
                                    FluentIcon {
                                        y: (parent.height - self.height) / 2;
                                        name: "chevron-right";
                                        icon-size: 12px;
                                        icon-color: root.text-primary;
                                    }
                                }
                                q4-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.nav-swipe-right(); }
                                }
                            }
                        }
                    }
                }

                // =====================================================================
                // RIGHT SIDE DRAWER (360px — Zero-Tear Atomic Windowed + 60Hz Fullscreen Glide)
                // =====================================================================
                drawer-panel := Rectangle {
                    width: root.drawer-animated-w;
                    clip: true;
                    visible: self.width > 1px;
                    background: root.surface-chrome;
                    animate background { duration: 180ms; easing: ease-in-out; }

                    Rectangle {
                        x: 0px;
                        y: 0px;
                        width: 1px;
                        height: 100%;
                        background: root.border-chrome;
                    }

                    VerticalLayout {
                        x: 1px + (1.0 - clamp(root.drawer-slide-progress, 0.0, 1.0)) * 14px;
                        y: 0px;
                        width: 359px;
                        height: parent.height;
                        opacity: clamp(root.drawer-slide-progress, 0.0, 1.0);
                        spacing: 0px;

                        // Drawer Header (40px)
                        Rectangle {
                            height: 40px;
                            background: transparent;
                            HorizontalLayout {
                                x: 14px;
                                y: 0px;
                                width: parent.width - 24px;
                                height: parent.height;
                                Text {
                                    text: root.is-en ? "Settings & Controls" : "Pengaturan & Kontrol";
                                    color: root.text-primary;
                                    font-size: 13px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                TopIconBtn {
                                    y: (parent.height - self.height) / 2;
                                    btn-size: 26px;
                                    icon-name: "close";
                                    dark-mode: root.dark-mode;
                                    clicked => { root.toggle-drawer(); }
                                }
                            }
                        }

                        // Scrollable 8-Card Drawer Content (Animation #1: 160ms fluid scroll)
                        drawer-flick := Flickable {
                            vertical-stretch: 1;
                            content-width: self.width;
                            content-height: drawer-cards-col.preferred-height;
                            content-y <=> root.drawer-viewport-y;
                            animate content-y { duration: 160ms; easing: cubic-bezier(0.16, 1.0, 0.3, 1.0); }

                            drawer-cards-col := VerticalLayout {
                                width: parent.width;
                                padding-left: 12px;
                                padding-right: 12px;
                                padding-bottom: 18px;
                                spacing: 10px;

                                // CARD 1: TAMPILAN & BAHASA
                                DrawerCard {
                                    title: root.is-en ? "APPEARANCE & LANGUAGE" : "TAMPILAN & BAHASA";
                                    dark-mode: root.dark-mode;

                                    Rectangle {
                                        height: 34px;
                                        border-radius: 17px;
                                        background: root.seg-track;
                                        HorizontalLayout {
                                            padding: 3px;
                                            spacing: 3px;
                                            SegPill {
                                                label: root.is-en ? "Dark" : "Gelap";
                                                icon-name: "moon";
                                                pill-height: 28px;
                                                active: root.dark-mode;
                                                dark-mode: root.dark-mode;
                                                clicked => { root.set-theme(true); }
                                            }
                                            SegPill {
                                                label: root.is-en ? "Light" : "Terang";
                                                icon-name: "sun";
                                                pill-height: 28px;
                                                active: !root.dark-mode;
                                                dark-mode: root.dark-mode;
                                                clicked => { root.set-theme(false); }
                                            }
                                        }
                                    }

                                    Text {
                                        text: root.is-en ? "Language" : "Bahasa";
                                        color: root.text-primary;
                                        font-size: 12px;
                                        font-weight: 500;
                                    }

                                    Rectangle {
                                        height: 34px;
                                        border-radius: 17px;
                                        background: root.seg-track;
                                        HorizontalLayout {
                                            padding: 3px;
                                            spacing: 3px;
                                            SegPill {
                                                label: "ID Indonesia";
                                                pill-height: 28px;
                                                active: !root.lang-en;
                                                dark-mode: root.dark-mode;
                                                clicked => { root.set-lang-en(false); }
                                            }
                                            SegPill {
                                                label: "EN English";
                                                pill-height: 28px;
                                                active: root.lang-en;
                                                dark-mode: root.dark-mode;
                                                clicked => { root.set-lang-en(true); }
                                            }
                                        }
                                    }
                                }

                                // CARD 2: RASIO & UKURAN LAYAR
                                DrawerCard {
                                    title: root.is-en ? "DISPLAY RATIO & SIZE" : "RASIO & UKURAN LAYAR";
                                    dark-mode: root.dark-mode;

                                    Rectangle {
                                        height: 34px;
                                        border-radius: 17px;
                                        background: root.seg-track;
                                        HorizontalLayout {
                                            padding: 3px;
                                            spacing: 3px;
                                            SegPill {
                                                label: root.is-en ? "Auto Fit" : "Otomatis";
                                                pill-height: 28px;
                                                active: root.fit-mode == "auto_fit";
                                                dark-mode: root.dark-mode;
                                                clicked => { root.set-fit-mode("auto_fit"); }
                                            }
                                            SegPill {
                                                label: root.is-en ? "Fill" : "Penuh";
                                                pill-height: 28px;
                                                active: root.fit-mode == "edge_to_edge";
                                                dark-mode: root.dark-mode;
                                                clicked => { root.set-fit-mode("edge_to_edge"); }
                                            }
                                            SegPill {
                                                label: root.is-en ? "Original Ratio" : "Rasio Asli";
                                                pill-height: 28px;
                                                active: root.fit-mode == "original_ratio";
                                                dark-mode: root.dark-mode;
                                                clicked => { root.set-fit-mode("original_ratio"); }
                                            }
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 6px;
                                        FluentIcon {
                                            y: 2px;
                                            name: "smartphone";
                                            icon-size: 13px;
                                            icon-color: root.text-muted;
                                        }
                                        Text {
                                            text: root.is-en ? "Device (Aspect)" : "Perangkat (Aspect)";
                                            color: root.text-primary;
                                            font-size: 11.5px;
                                            horizontal-stretch: 1;
                                        }
                                        Text {
                                            text: root.device-profile == "ipad" ? "iPad (4:3)"
                                                : (root.device-profile == "iphone" ? "iPhone" : "Auto (iPhone)");
                                            color: root.text-muted;
                                            font-size: 10.5px;
                                        }
                                    }

                                    Rectangle {
                                        height: 34px;
                                        border-radius: 17px;
                                        background: root.seg-track;
                                        HorizontalLayout {
                                            padding: 3px;
                                            spacing: 3px;
                                            SegPill {
                                                label: "Auto";
                                                pill-height: 28px;
                                                active: root.device-profile == "auto";
                                                dark-mode: root.dark-mode;
                                                clicked => { root.set-device-profile("auto"); }
                                            }
                                            SegPill {
                                                label: "iPhone";
                                                pill-height: 28px;
                                                active: root.device-profile == "iphone";
                                                dark-mode: root.dark-mode;
                                                clicked => { root.set-device-profile("iphone"); }
                                            }
                                            SegPill {
                                                label: "iPad (4:3)";
                                                pill-height: 28px;
                                                active: root.device-profile == "ipad";
                                                dark-mode: root.dark-mode;
                                                clicked => { root.set-device-profile("ipad"); }
                                            }
                                        }
                                    }

                                    ActionBtn {
                                        label: root.is-en ? "Reset Default Size (1:1)" : "Reset Ukuran Default (1:1)";
                                        icon-name: "fullscreen";
                                        dark-mode: root.dark-mode;
                                        clicked => { root.reset-window-size(); }
                                    }

                                    HorizontalLayout {
                                        spacing: 6px;
                                        FluentIcon {
                                            y: 2px;
                                            name: "gamepad";
                                            icon-size: 13px;
                                            icon-color: root.text-muted;
                                        }
                                        Text {
                                            text: root.is-en ? "Game Auto-Rotate" : "Putar Otomatis Game";
                                            color: root.text-primary;
                                            font-size: 11.5px;
                                            horizontal-stretch: 1;
                                        }
                                        Text {
                                            text: "eFootball / Genshin";
                                            color: root.text-muted;
                                            font-size: 10.5px;
                                        }
                                    }

                                    Rectangle {
                                        height: 32px;
                                        border-radius: 16px;
                                        background: root.seg-track;
                                        HorizontalLayout {
                                            padding: 3px;
                                            spacing: 3px;
                                            SegPill {
                                                label: "OFF";
                                                pill-height: 26px;
                                                active: !root.auto-rotate;
                                                dark-mode: root.dark-mode;
                                                clicked => { root.set-auto-rotate(false); }
                                            }
                                            SegPill {
                                                label: "ON";
                                                pill-height: 26px;
                                                active: root.auto-rotate;
                                                dark-mode: root.dark-mode;
                                                clicked => { root.set-auto-rotate(true); }
                                            }
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 6px;
                                        FluentIcon {
                                            y: 2px;
                                            name: "monitor";
                                            icon-size: 13px;
                                            icon-color: root.text-muted;
                                        }
                                        Text {
                                            text: root.is-en ? "Video Stream Mode" : "Mode Video Stream";
                                            color: root.text-primary;
                                            font-size: 11.5px;
                                            horizontal-stretch: 1;
                                        }
                                        Text {
                                            text: root.stream-mode == "airplay" ? "AirPlay" : "Auto";
                                            color: root.text-muted;
                                            font-size: 10.5px;
                                        }
                                    }

                                    Rectangle {
                                        height: 34px;
                                        border-radius: 17px;
                                        background: root.seg-track;
                                        HorizontalLayout {
                                            padding: 3px;
                                            spacing: 3px;
                                            SegPill {
                                                label: root.is-en ? "Auto (Recommended)" : "Auto (Disarankan)";
                                                pill-height: 28px;
                                                active: root.stream-mode != "airplay";
                                                dark-mode: root.dark-mode;
                                                clicked => { root.set-stream-mode("auto"); }
                                            }
                                            SegPill {
                                                label: "AirPlay H.264";
                                                pill-height: 28px;
                                                active: root.stream-mode == "airplay";
                                                dark-mode: root.dark-mode;
                                                clicked => { root.set-stream-mode("airplay"); }
                                            }
                                        }
                                    }

                                    Text {
                                        text: root.is-en
                                            ? "iOS 27+: HEVC 60 FPS + full control · iOS 17-26: AirPlay H.264 + Audio (View Only)"
                                            : "iOS 27+: HEVC 60 FPS + kontrol penuh · iOS 17-26: AirPlay H.264 + Audio (Tampilan Saja)";
                                        color: root.text-muted;
                                        font-size: 10px;
                                        wrap: word-wrap;
                                    }

                                    // 4-Edge Crop Precision Subbox (0-24 px)
                                    Rectangle {
                                        border-radius: 10px;
                                        border-width: 1px;
                                        border-color: root.dark-mode ? #FFFFFF24 : #0F172A1E;
                                        background: root.sub-surface;

                                        VerticalLayout {
                                            padding: 10px;
                                            spacing: 7px;

                                            HorizontalLayout {
                                                spacing: 6px;
                                                FluentIcon {
                                                    y: 1px;
                                                    name: "crop";
                                                    icon-size: 12px;
                                                    icon-color: root.text-muted;
                                                }
                                                Text {
                                                    text: root.is-en ? "EDGE CROP (0-24 PX PRECISION)" : "POTONG TEPI (0-24 PX PRESISI)";
                                                    color: root.text-muted;
                                                    font-size: 10px;
                                                    font-weight: 700;
                                                    horizontal-stretch: 1;
                                                }
                                            }

                                            DrawerSlider {
                                                label: root.is-en ? "Top" : "Atas (Top)";
                                                value: root.crop-top;
                                                min-val: 0;
                                                max-val: 24;
                                                unit: "px";
                                                dark-mode: root.dark-mode;
                                                value-changed(v) => { root.set-crop-edge("top", v); }
                                            }
                                            DrawerSlider {
                                                label: root.is-en ? "Bottom" : "Bawah (Bottom)";
                                                value: root.crop-bottom;
                                                min-val: 0;
                                                max-val: 24;
                                                unit: "px";
                                                dark-mode: root.dark-mode;
                                                value-changed(v) => { root.set-crop-edge("bottom", v); }
                                            }
                                            DrawerSlider {
                                                label: root.is-en ? "Left" : "Kiri (Left)";
                                                value: root.crop-left;
                                                min-val: 0;
                                                max-val: 24;
                                                unit: "px";
                                                dark-mode: root.dark-mode;
                                                value-changed(v) => { root.set-crop-edge("left", v); }
                                            }
                                            DrawerSlider {
                                                label: root.is-en ? "Right" : "Kanan (Right)";
                                                value: root.crop-right;
                                                min-val: 0;
                                                max-val: 24;
                                                unit: "px";
                                                dark-mode: root.dark-mode;
                                                value-changed(v) => { root.set-crop-edge("right", v); }
                                            }

                                            HorizontalLayout {
                                                spacing: 6px;
                                                ActionBtn {
                                                    horizontal-stretch: 1;
                                                    btn-height: 30px;
                                                    label: "Reset (0 px)";
                                                    dark-mode: root.dark-mode;
                                                    clicked => { root.reset-crop(); }
                                                }
                                                ActionBtn {
                                                    horizontal-stretch: 1;
                                                    btn-height: 30px;
                                                    label: root.is-en ? "Save Crop" : "Simpan Crop";
                                                    icon-name: "save-floppy";
                                                    primary: true;
                                                    fb-state: root.fb-crop-state;
                                                    fb-label: root.fb-crop-text;
                                                    dark-mode: root.dark-mode;
                                                    clicked => { root.save-crop(); }
                                                }
                                            }
                                        }
                                    }
                                }

                                // CARD 3: AUDIO (IPHONE -> PC)
                                DrawerCard {
                                    title: "AUDIO (IPHONE -> PC)";
                                    dark-mode: root.dark-mode;

                                    Rectangle {
                                        height: 28px;
                                        border-radius: 8px;
                                        border-width: 1px;
                                        border-color: root.audio-live-state == "active" ? #10B98166
                                            : root.audio-live-state == "connecting" ? #38BDF866
                                            : (root.audio-live-state == "muted" || root.audio-live-state == "error") ? #EF444466
                                            : (root.dark-mode ? #FFFFFF24 : #0F172A1E);
                                        background: root.audio-live-state == "active" ? (root.dark-mode ? #064E3B66 : #D1FAE5CC)
                                            : root.audio-live-state == "connecting" ? (root.dark-mode ? #0C4A6E55 : #E0F2FECC)
                                            : (root.audio-live-state == "muted" || root.audio-live-state == "error") ? (root.dark-mode ? #7F1D1D55 : #FEE2E2CC)
                                            : root.sub-surface;
                                        HorizontalLayout {
                                            padding-left: 9px;
                                            padding-right: 9px;
                                            spacing: 6px;
                                            FluentIcon {
                                                y: (parent.height - self.height) / 2;
                                                name: root.audio-live-state == "active" ? "check"
                                                    : root.audio-live-state == "connecting" ? "refresh"
                                                    : (root.audio-live-state == "muted" || root.audio-live-state == "device") ? "audio-off"
                                                    : root.audio-live-state == "error" ? "warning"
                                                    : "audio-on";
                                                icon-size: 13px;
                                                icon-color: root.audio-live-state == "active" ? (root.dark-mode ? #34D399 : #047857)
                                                    : root.audio-live-state == "connecting" ? (root.dark-mode ? #38BDF8 : #0369A1)
                                                    : (root.audio-live-state == "muted" || root.audio-live-state == "error") ? (root.dark-mode ? #FCA5A5 : #B91C1C)
                                                    : root.text-muted;
                                            }
                                            Text {
                                                text: root.audio-status-banner;
                                                color: root.audio-live-state == "active" ? (root.dark-mode ? #A7F3D0 : #065F46)
                                                    : root.audio-live-state == "connecting" ? (root.dark-mode ? #BAE6FD : #0369A1)
                                                    : (root.audio-live-state == "muted" || root.audio-live-state == "error") ? (root.dark-mode ? #FECACA : #991B1B)
                                                    : root.text-muted;
                                                font-size: 10.5px;
                                                font-weight: 600;
                                                vertical-alignment: center;
                                                horizontal-stretch: 1;
                                                overflow: elide;
                                            }
                                        }
                                    }

                                    Rectangle {
                                        height: 34px;
                                        border-radius: 17px;
                                        background: root.seg-track;
                                        HorizontalLayout {
                                            padding: 3px;
                                            spacing: 3px;
                                            SegPill {
                                                label: root.is-en ? "This PC (USB)" : "Di PC ini (USB)";
                                                icon-name: "audio-on";
                                                pill-height: 28px;
                                                active: root.audio-pc-active;
                                                dark-mode: root.dark-mode;
                                                clicked => { root.set-audio-routing("pc"); }
                                            }
                                            SegPill {
                                                label: root.is-en ? "Device only" : "Hanya perangkat";
                                                icon-name: "smartphone";
                                                pill-height: 28px;
                                                active: !root.audio-pc-active;
                                                dark-mode: root.dark-mode;
                                                clicked => { root.set-audio-routing("device"); }
                                            }
                                        }
                                    }

                                    // Volume PC row + inline Alt+M mute pill + 0..100% slider (always visible)
                                    HorizontalLayout {
                                        spacing: 6px;
                                        Text {
                                            text: root.is-en ? "PC Volume" : "Volume PC";
                                            color: root.text-primary;
                                            font-size: 11px;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                        }
                                        Text {
                                            text: root.airplay-volume + "%";
                                            color: root.text-primary;
                                            font-size: 11px;
                                            font-weight: 600;
                                            vertical-alignment: center;
                                        }
                                        Rectangle {
                                            y: (parent.height - self.height) / 2;
                                            width: 58px;
                                            height: 22px;
                                            border-radius: 6px;
                                            border-width: 1px;
                                            border-color: root.audio-muted ? #EF4444AA : (root.dark-mode ? #434754 : #CBD5E1);
                                            background: root.audio-muted ? (root.dark-mode ? #7F1D1D66 : #FEE2E2CC) : root.sub-surface;
                                            HorizontalLayout {
                                                alignment: center;
                                                spacing: 4px;
                                                FluentIcon {
                                                    y: (parent.height - self.height) / 2;
                                                    name: root.audio-muted ? "audio-off" : "audio-on";
                                                    icon-size: 12px;
                                                    icon-color: root.audio-muted ? (root.dark-mode ? #FCA5A5 : #B91C1C) : root.text-primary;
                                                }
                                                Text {
                                                    text: "Alt+M";
                                                    color: root.audio-muted ? (root.dark-mode ? #FCA5A5 : #B91C1C) : root.text-primary;
                                                    font-size: 9.5px;
                                                    font-weight: 600;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.toggle-audio-mute(); }
                                            }
                                        }
                                    }

                                    DrawerSlider {
                                        show-header: false;
                                        label: "";
                                        value: root.airplay-volume;
                                        min-val: 0;
                                        max-val: 100;
                                        unit: "%";
                                        dark-mode: root.dark-mode;
                                        value-changed(v) => { root.set-airplay-volume(v); }
                                    }

                                    HorizontalLayout {
                                        spacing: 6px;
                                        Text {
                                            text: root.is-en ? "Audio Buffer" : "Buffer Audio";
                                            color: root.text-primary;
                                            font-size: 11px;
                                            horizontal-stretch: 1;
                                        }
                                        Text {
                                            text: root.airplay-buffer == "low"
                                                ? (root.is-en ? "Low ~20 ms" : "Rendah ~20 ms")
                                                : (root.airplay-buffer == "high"
                                                    ? (root.is-en ? "High ~80 ms" : "Tinggi ~80 ms")
                                                    : "Normal ~40 ms");
                                            color: root.text-muted;
                                            font-size: 10.5px;
                                        }
                                    }

                                    Rectangle {
                                        height: 30px;
                                        border-radius: 15px;
                                        background: root.seg-track;
                                        HorizontalLayout {
                                            padding: 2px;
                                            spacing: 2px;
                                            SegPill {
                                                label: root.is-en ? "Low" : "Rendah";
                                                font-px: 10.5px;
                                                pill-height: 26px;
                                                active: root.airplay-buffer == "low";
                                                dark-mode: root.dark-mode;
                                                clicked => { root.set-airplay-buffer("low"); }
                                            }
                                            SegPill {
                                                label: "Normal";
                                                font-px: 10.5px;
                                                pill-height: 26px;
                                                active: root.airplay-buffer == "normal";
                                                dark-mode: root.dark-mode;
                                                clicked => { root.set-airplay-buffer("normal"); }
                                            }
                                            SegPill {
                                                label: root.is-en ? "High" : "Tinggi";
                                                font-px: 10.5px;
                                                pill-height: 26px;
                                                active: root.airplay-buffer == "high";
                                                dark-mode: root.dark-mode;
                                                clicked => { root.set-airplay-buffer("high"); }
                                            }
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 6px;
                                        Text {
                                            text: root.is-en ? "Audio Sync (Lip Sync)" : "Sinkron Audio (Lip Sync)";
                                            color: root.text-primary;
                                            font-size: 11px;
                                            horizontal-stretch: 1;
                                        }
                                        Text {
                                            text: root.airplay-lip-sync ? "ON" : "OFF";
                                            color: root.airplay-lip-sync ? #10B981 : root.text-muted;
                                            font-size: 10.5px;
                                            font-weight: 700;
                                        }
                                    }

                                    Rectangle {
                                        height: 30px;
                                        border-radius: 15px;
                                        background: root.seg-track;
                                        HorizontalLayout {
                                            padding: 2px;
                                            spacing: 2px;
                                            SegPill {
                                                label: "OFF";
                                                font-px: 10.5px;
                                                pill-height: 26px;
                                                active: !root.airplay-lip-sync;
                                                dark-mode: root.dark-mode;
                                                clicked => { root.set-airplay-lip-sync(false); }
                                            }
                                            SegPill {
                                                label: "ON";
                                                font-px: 10.5px;
                                                pill-height: 26px;
                                                active: root.airplay-lip-sync;
                                                dark-mode: root.dark-mode;
                                                clicked => { root.set-airplay-lip-sync(true); }
                                            }
                                        }
                                    }

                                    DrawerAccordion {
                                        title: root.is-en ? "Bluetooth A2DP Fallback Options" : "Opsi Fallback Bluetooth A2DP";
                                        badge: root.bt-audio-active ? "BT" : "";
                                        open: root.acc-bt-fallback-open;
                                        dark-mode: root.dark-mode;
                                        toggled => { root.acc-bt-fallback-open = !root.acc-bt-fallback-open; }

                                        HorizontalLayout {
                                            spacing: 6px;
                                            ActionBtn {
                                                horizontal-stretch: 1;
                                                btn-height: 29px;
                                                label: root.is-en ? "Use Bluetooth" : "Gunakan Bluetooth";
                                                icon-name: "bluetooth";
                                                active: root.bt-audio-active;
                                                dark-mode: root.dark-mode;
                                                clicked => { root.set-audio-routing("bluetooth"); }
                                            }
                                            ActionBtn {
                                                horizontal-stretch: 1;
                                                btn-height: 29px;
                                                label: root.is-en ? "Pair BT" : "Pasangkan BT";
                                                icon-name: "link";
                                                dark-mode: root.dark-mode;
                                                clicked => { root.pair-bluetooth-audio(); }
                                            }
                                        }
                                    }
                                }

                                // CARD 4: KECEPATAN GESTUR TRACKPAD (Standalone Card — 1:1 Tahap 259)
                                DrawerCard {
                                    title: root.is-en ? "TRACKPAD GESTURE SPEED" : "KECEPATAN GESTUR TRACKPAD";
                                    dark-mode: root.dark-mode;

                                    Rectangle {
                                        height: 32px;
                                        border-radius: 16px;
                                        background: root.seg-track;
                                        HorizontalLayout {
                                            padding: 2px;
                                            spacing: 2px;
                                            SegPill {
                                                label: root.is-en ? "Slow (65%)" : "Lambat (65%)";
                                                font-px: 10px;
                                                pill-height: 28px;
                                                active: root.trackpad-speed == 65;
                                                dark-mode: root.dark-mode;
                                                clicked => { root.set-trackpad-speed(65); }
                                            }
                                            SegPill {
                                                label: root.is-en ? "Standard (100%)" : "Standar (100%)";
                                                font-px: 10px;
                                                pill-height: 28px;
                                                active: root.trackpad-speed == 100;
                                                dark-mode: root.dark-mode;
                                                clicked => { root.set-trackpad-speed(100); }
                                            }
                                            SegPill {
                                                label: root.is-en ? "Fast (140%)" : "Cepat (140%)";
                                                font-px: 10px;
                                                pill-height: 28px;
                                                active: root.trackpad-speed == 140;
                                                dark-mode: root.dark-mode;
                                                clicked => { root.set-trackpad-speed(140); }
                                            }
                                        }
                                    }

                                    DrawerSlider {
                                        label: root.is-en ? "Speed Sensitivity" : "Sensitivitas Kecepatan";
                                        value: root.trackpad-speed;
                                        min-val: 30;
                                        max-val: 200;
                                        unit: "%";
                                        dark-mode: root.dark-mode;
                                        value-changed(v) => { root.set-trackpad-speed(v); }
                                    }

                                    ActionBtn {
                                        label: root.is-en ? "Save Speed" : "Simpan Kecepatan";
                                        icon-name: "save-floppy";
                                        primary: true;
                                        fb-state: root.fb-speed-state;
                                        fb-label: root.fb-speed-text;
                                        dark-mode: root.dark-mode;
                                        clicked => { root.save-trackpad-speed(); }
                                    }
                                }

                                // CARD 5: KEYBOARD & PINTASAN (Exact 15 Chips + URL Bridge + Exact Labels)
                                DrawerCard {
                                    title: root.is-en ? "KEYBOARD & SHORTCUTS" : "KEYBOARD & PINTASAN";
                                    dark-mode: root.dark-mode;

                                    HorizontalLayout {
                                        spacing: 6px;
                                        FluentIcon {
                                            y: 2px;
                                            name: "sparkles";
                                            icon-size: 13px;
                                            icon-color: root.text-muted;
                                        }
                                        Text {
                                            text: root.is-en ? "Cross-Platform Shortcuts" : "Pintasan Lintas Platform";
                                            color: root.text-primary;
                                            font-size: 11px;
                                            horizontal-stretch: 1;
                                        }
                                        Text {
                                            text: "Ctrl -> Cmd";
                                            color: root.text-muted;
                                            font-size: 10px;
                                        }
                                    }

                                    Rectangle {
                                        height: 30px;
                                        border-radius: 15px;
                                        background: root.seg-track;
                                        HorizontalLayout {
                                            padding: 2px;
                                            spacing: 2px;
                                            SegPill {
                                                label: "ON";
                                                font-px: 10.5px;
                                                pill-height: 26px;
                                                active: root.cross-platform-shortcuts;
                                                dark-mode: root.dark-mode;
                                                clicked => { root.set-cross-platform-shortcuts(true); }
                                            }
                                            SegPill {
                                                label: "OFF";
                                                font-px: 10.5px;
                                                pill-height: 26px;
                                                active: !root.cross-platform-shortcuts;
                                                dark-mode: root.dark-mode;
                                                clicked => { root.set-cross-platform-shortcuts(false); }
                                            }
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 6px;
                                        FluentIcon {
                                            y: 2px;
                                            name: "paste";
                                            icon-size: 13px;
                                            icon-color: root.text-muted;
                                        }
                                        Text {
                                            text: root.is-en ? "Ctrl+V Pastes PC Clipboard" : "Ctrl+V Tempel Clipboard PC";
                                            color: root.text-primary;
                                            font-size: 11px;
                                            horizontal-stretch: 1;
                                        }
                                        Text {
                                            text: "PC -> iPhone";
                                            color: root.text-muted;
                                            font-size: 10px;
                                        }
                                    }

                                    Rectangle {
                                        height: 30px;
                                        border-radius: 15px;
                                        background: root.seg-track;
                                        HorizontalLayout {
                                            padding: 2px;
                                            spacing: 2px;
                                            SegPill {
                                                label: "ON";
                                                font-px: 10.5px;
                                                pill-height: 26px;
                                                active: root.paste-pc-clipboard;
                                                dark-mode: root.dark-mode;
                                                clicked => { root.set-paste-pc-clipboard(true); }
                                            }
                                            SegPill {
                                                label: "OFF";
                                                font-px: 10.5px;
                                                pill-height: 26px;
                                                active: !root.paste-pc-clipboard;
                                                dark-mode: root.dark-mode;
                                                clicked => { root.set-paste-pc-clipboard(false); }
                                            }
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 6px;
                                        ActionBtn {
                                            horizontal-stretch: 1;
                                            btn-height: 40px;
                                            wrap-label: true;
                                            label-font-px: 10.5px;
                                            label: root.is-en ? "Paste PC Text (Alt+V)" : "Tempel Teks PC (Alt+V)";
                                            icon-name: "paste";
                                            fb-state: root.fb-paste-state;
                                            fb-label: root.fb-paste-text;
                                            dark-mode: root.dark-mode;
                                            clicked => { root.paste-to-iphone(); }
                                        }
                                        ActionBtn {
                                            horizontal-stretch: 1;
                                            btn-height: 40px;
                                            wrap-label: true;
                                            label-font-px: 10.5px;
                                            label: root.is-en ? "Copy iPhone Text (Alt+C)" : "Salin Teks iPhone (Alt+C)";
                                            icon-name: "copy";
                                            fb-state: root.fb-ocr-state;
                                            fb-label: root.fb-ocr-text;
                                            dark-mode: root.dark-mode;
                                            clicked => { root.copy-ocr-text(); }
                                        }
                                    }

                                    ActionBtn {
                                        label: root.is-en ? "Clear Copy Cache (Alt+R)" : "Bersihkan Cache Salin (Alt+R)";
                                        icon-name: "trash";
                                        fb-state: root.fb-cache-state;
                                        fb-label: root.fb-cache-text;
                                        dark-mode: root.dark-mode;
                                        clicked => { root.clear-ocr-cache(); }
                                    }

                                    ActionBtn {
                                        label: "Grab Link (Alt+B)";
                                        icon-name: "link";
                                        primary: true;
                                        fb-state: root.fb-grab-state;
                                        fb-label: root.fb-grab-text;
                                        dark-mode: root.dark-mode;
                                        clicked => { root.grab-link-action(); }
                                    }

                                    if root.clipboard-feedback != "" : Text {
                                        text: root.clipboard-feedback;
                                        color: root.dark-mode ? #34D399 : #047857;
                                        font-size: 10.5px;
                                        wrap: word-wrap;
                                    }

                                    // Sub-card: iOS 27 Shortcut — URL Server PC (100% Akurat, ~5ms)
                                    Rectangle {
                                        border-radius: 10px;
                                        border-width: 1px;
                                        border-color: root.dark-mode ? #38BDF855 : #0284C744;
                                        background: root.dark-mode ? #0E749024 : #E0F2FEB8;

                                        VerticalLayout {
                                            padding: 9px;
                                            spacing: 6px;

                                            HorizontalLayout {
                                                spacing: 6px;
                                                Text {
                                                    text: root.is-en
                                                        ? "iOS 27 Shortcut — PC Server URL (100% Accurate, ~5ms)"
                                                        : "iOS 27 Shortcut — URL Server PC (100% Akurat, ~5ms)";
                                                    color: root.dark-mode ? #38BDF8 : #0369A1;
                                                    font-size: 10px;
                                                    font-weight: 700;
                                                    wrap: word-wrap;
                                                    horizontal-stretch: 1;
                                                }
                                                TouchArea {
                                                    width: guide-lnk.preferred-width + 4px;
                                                    mouse-cursor: pointer;
                                                    clicked => { root.acc-shortcut-guide-open = !root.acc-shortcut-guide-open; }
                                                    guide-lnk := Text {
                                                        text: root.is-en ? "Setup Guide" : "Panduan Setup";
                                                        color: root.dark-mode ? #7DD3FC : #0284C7;
                                                        font-size: 10px;
                                                        font-weight: 600;
                                                    }
                                                }
                                            }

                                            if root.acc-shortcut-guide-open : Text {
                                                text: root.is-en
                                                    ? "1. Install Apple Shortcut  2. Share post/text -> iPhone Link  3. URL opens on Windows in ~5ms"
                                                    : "1. Pasang Apple Shortcut  2. Share postingan/teks -> iPhone Link  3. Tautan langsung diterima Windows ~5ms";
                                                color: root.text-muted;
                                                font-size: 9.5px;
                                                wrap: word-wrap;
                                            }

                                            HorizontalLayout {
                                                spacing: 5px;
                                                Rectangle {
                                                    horizontal-stretch: 1;
                                                    height: 27px;
                                                    border-radius: 6px;
                                                    border-width: 1px;
                                                    border-color: root.dark-mode ? #FFFFFF24 : #0F172A1E;
                                                    background: root.dark-mode ? #0C111C66 : #FFFFFFB8;
                                                    Text {
                                                        x: 7px;
                                                        width: parent.width - 14px;
                                                        height: parent.height;
                                                        text: root.shortcut-bridge-url;
                                                        color: root.dark-mode ? #93C5FD : #0F172A;
                                                        font-size: 10px;
                                                        vertical-alignment: center;
                                                        overflow: elide;
                                                    }
                                                }
                                                ActionBtn {
                                                    width: 78px;
                                                    btn-height: 27px;
                                                    label: root.is-en ? "Copy URL" : "Salin URL";
                                                    dark-mode: root.dark-mode;
                                                    clicked => { root.copy-shortcut-url(); }
                                                }
                                            }

                                            Text {
                                                text: root.is-en
                                                    ? ("USE PC IP (" + root.pc-lan-ip + ") — Do not use iPhone IP in Shortcut! Auto 100% accurate without OCR")
                                                    : ("GUNAKAN IP PC (" + root.pc-lan-ip + ") — Jangan gunakan IP iPhone di Shortcut! Auto 100% akurat tanpa OCR");
                                                color: root.dark-mode ? #CBD5E1 : #1E293B;
                                                font-size: 9.5px;
                                                font-weight: 600;
                                                wrap: word-wrap;
                                            }

                                            HorizontalLayout {
                                                spacing: 5px;
                                                ActionBtn {
                                                    horizontal-stretch: 1;
                                                    btn-height: 40px;
                                                    wrap-label: true;
                                                    label-font-px: 10.5px;
                                                    label: root.is-en ? "Get iCloud Shortcut" : "Ambil iCloud Shortcut";
                                                    icon-name: "link";
                                                    dark-mode: root.dark-mode;
                                                    clicked => { root.open-icloud-shortcut(); }
                                                }
                                                ActionBtn {
                                                    horizontal-stretch: 1;
                                                    btn-height: 40px;
                                                    wrap-label: true;
                                                    label-font-px: 10.5px;
                                                    label: root.is-en ? "Copy Shortcut Prompt" : "Salin Prompt Shortcut";
                                                    icon-name: "copy";
                                                    dark-mode: root.dark-mode;
                                                    clicked => { root.copy-siri-prompt(); }
                                                }
                                            }
                                        }
                                    }

                                    ActionBtn {
                                        label: root.is-en ? "Toggle iPhone On-Screen Keyboard (Ctrl+K)" : "Tampilkan Keyboard Layar iPhone (Ctrl+K)";
                                        icon-name: "keyboard";
                                        emerald: root.keyboard-enabled;
                                        active: root.onscreen-kb-active;
                                        dark-mode: root.dark-mode;
                                        clicked => { root.toggle-onscreen-keyboard(); }
                                    }

                                    // Exact 15 Shortcut Cheat-Sheet Chips (Always Visible 2-Column Grid)
                                    HorizontalLayout {
                                        spacing: 5px;
                                        ShortcutPillChip { label: "Ctrl+A (Select All)"; dark-mode: root.dark-mode; }
                                        ShortcutPillChip { label: "Ctrl+C (iOS Copy)"; dark-mode: root.dark-mode; }
                                    }
                                    HorizontalLayout {
                                        spacing: 5px;
                                        ShortcutPillChip { label: "Ctrl+V (iOS Paste)"; dark-mode: root.dark-mode; }
                                        ShortcutPillChip { label: "Alt+C (Copy to PC)"; dark-mode: root.dark-mode; }
                                    }
                                    HorizontalLayout {
                                        spacing: 5px;
                                        ShortcutPillChip { label: "Alt+V (Paste PC Text)"; dark-mode: root.dark-mode; }
                                        ShortcutPillChip { label: "Alt+R (Clear Cache)"; dark-mode: root.dark-mode; }
                                    }
                                    HorizontalLayout {
                                        spacing: 5px;
                                        ShortcutPillChip { label: "Alt+B (Grab Link)"; dark-mode: root.dark-mode; }
                                        ShortcutPillChip { label: "Ctrl+X (Cut)"; dark-mode: root.dark-mode; }
                                    }
                                    HorizontalLayout {
                                        spacing: 5px;
                                        ShortcutPillChip { label: "Ctrl+Z (Undo)"; dark-mode: root.dark-mode; }
                                        ShortcutPillChip { label: "Ctrl+K (Keyboard)"; dark-mode: root.dark-mode; }
                                    }
                                    HorizontalLayout {
                                        spacing: 5px;
                                        ShortcutPillChip { label: "Alt+U (Unlock)"; dark-mode: root.dark-mode; }
                                        ShortcutPillChip { label: "Alt+L (Lock)"; dark-mode: root.dark-mode; }
                                    }
                                    HorizontalLayout {
                                        spacing: 5px;
                                        ShortcutPillChip { label: "Alt+D (Stealth)"; dark-mode: root.dark-mode; }
                                        ShortcutPillChip { label: "Alt+H (Landscape)"; dark-mode: root.dark-mode; }
                                    }
                                    HorizontalLayout {
                                        spacing: 5px;
                                        ShortcutPillChip { label: "Alt+M (Mute)"; dark-mode: root.dark-mode; }
                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                    }
                                }

                                // CARD 6: LAYAR IPHONE & MODE SILUMAN
                                DrawerCard {
                                    title: root.is-en ? "IPHONE SCREEN & STEALTH CONTROL" : "LAYAR IPHONE & MODE SILUMAN";
                                    dark-mode: root.dark-mode;

                                    HorizontalLayout {
                                        spacing: 6px;
                                        ActionBtn {
                                            horizontal-stretch: 1;
                                            label: root.is-en ? "Wake / Unlock (Alt+U)" : "Bangun / Buka (Alt+U)";
                                            icon-name: "unlock";
                                            primary: true;
                                            fb-state: root.fb-wake-state;
                                            fb-label: root.fb-wake-text;
                                            dark-mode: root.dark-mode;
                                            clicked => { root.wake-unlock(); }
                                        }
                                        ActionBtn {
                                            horizontal-stretch: 1;
                                            label: root.is-en ? "Lock iPhone (Alt+L)" : "Kunci iPhone (Alt+L)";
                                            icon-name: "lock";
                                            fb-state: root.fb-lock-state;
                                            fb-label: root.fb-lock-text;
                                            dark-mode: root.dark-mode;
                                            clicked => { root.lock-screen(); }
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 6px;
                                        FluentIcon {
                                            y: 2px;
                                            name: "eye-off";
                                            icon-size: 13px;
                                            icon-color: root.text-muted;
                                        }
                                        Text {
                                            text: root.is-en ? "Stealth Dim Mode (Alt+D)" : "Mode Redup Stealth (Alt+D)";
                                            color: root.text-primary;
                                            font-size: 11px;
                                            horizontal-stretch: 1;
                                        }
                                        Text {
                                            text: root.stealth-active ? "ON" : "OFF";
                                            color: root.stealth-active ? #10B981 : root.text-muted;
                                            font-size: 10.5px;
                                            font-weight: 700;
                                        }
                                    }

                                    ActionBtn {
                                        label: root.stealth-active
                                            ? (root.is-en ? "Stealth Dim Mode: ON" : "Mode Redup Stealth: ON")
                                            : (root.is-en ? "Stealth Dim Mode: OFF" : "Mode Redup Stealth: OFF");
                                        icon-name: "moon";
                                        active: root.stealth-active;
                                        fb-state: root.fb-stealth-state;
                                        fb-label: root.fb-stealth-text;
                                        dark-mode: root.dark-mode;
                                        clicked => { root.toggle-stealth(); }
                                    }

                                    Text {
                                        text: root.is-en
                                            ? "Dim physical iPhone screen to 0% when controlled over USB (PC display remains bright)."
                                            : "Redupkan layar fisik iPhone ke 0% saat dikontrol via USB (tampilan di PC tetap terang).";
                                        color: root.text-muted;
                                        font-size: 10px;
                                        wrap: word-wrap;
                                    }

                                    Text {
                                        text: root.is-en ? "Auto-Unlock PIN (Optional):" : "Auto-Unlock PIN (Opsional):";
                                        color: root.text-primary;
                                        font-size: 11px;
                                        font-weight: 500;
                                    }

                                    HorizontalLayout {
                                        spacing: 6px;
                                        Rectangle {
                                            horizontal-stretch: 1;
                                            height: 30px;
                                            border-radius: 8px;
                                            border-width: 1px;
                                            border-color: pin-ti.has-focus ? #0DA5F0 : (root.dark-mode ? #FFFFFF26 : #0F172A22);
                                            background: root.dark-mode ? #0C111C66 : #FFFFFFCC;
                                            if root.unlock-pin-input == "" : Text {
                                                x: 8px;
                                                y: 0px;
                                                width: parent.width - 42px;
                                                height: parent.height;
                                                text: root.is-en ? "4 or 6 digits" : "4 atau 6 digit";
                                                color: root.text-muted;
                                                font-size: 11px;
                                                vertical-alignment: center;
                                            }
                                            pin-ti := TextInput {
                                                x: 8px;
                                                y: 0px;
                                                width: parent.width - 42px;
                                                height: parent.height;
                                                text <=> root.unlock-pin-input;
                                                input-type: root.pin-revealed ? InputType.text : InputType.password;
                                                color: root.text-primary;
                                                font-size: 12px;
                                                vertical-alignment: center;
                                                changed has-focus => {
                                                    root.pin-editing = self.has-focus;
                                                    root.pin-focus-changed(self.has-focus);
                                                }
                                                edited => {
                                                    root.pin-editing = true;
                                                    root.pin-focus-changed(true);
                                                    root.pin-text-edited(self.text);
                                                }
                                                accepted => {
                                                    root.pin-editing = false;
                                                    root.pin-focus-changed(false);
                                                    root.save-unlock-pin(root.unlock-pin-input);
                                                }
                                            }
                                            TopIconBtn {
                                                x: parent.width - 28px;
                                                y: 3px;
                                                btn-size: 24px;
                                                icon-px: 13px;
                                                icon-name: root.pin-revealed ? "eye-off" : "eye";
                                                caption-btn: true;
                                                dark-mode: root.dark-mode;
                                                clicked => { root.pin-revealed = !root.pin-revealed; }
                                            }
                                        }
                                        ActionBtn {
                                            width: 82px;
                                            btn-height: 30px;
                                            label: root.is-en ? "Save PIN" : "Simpan PIN";
                                            fb-state: root.fb-pin-state;
                                            fb-label: root.fb-pin-text;
                                            dark-mode: root.dark-mode;
                                            clicked => {
                                                root.pin-editing = false;
                                                root.pin-focus-changed(false);
                                                root.save-unlock-pin(root.unlock-pin-input);
                                            }
                                        }
                                        if root.pin-saved : ActionBtn {
                                            width: 56px;
                                            btn-height: 30px;
                                            label: root.is-en ? "Clear" : "Hapus";
                                            danger: true;
                                            dark-mode: root.dark-mode;
                                            clicked => {
                                                root.pin-editing = false;
                                                root.pin-focus-changed(false);
                                                root.clear-unlock-pin();
                                            }
                                        }
                                    }

                                    Text {
                                        text: root.pin-saved
                                            ? (root.is-en ? "PIN stored locally only (encrypted via Windows DPAPI)." : "PIN tersimpan di lokal saja (enkripsi Windows DPAPI).")
                                            : (root.is-en ? "Stored locally only. Leave blank to enter PIN manually." : "Tersimpan di lokal saja. Kosongkan jika ingin mengetik PIN manual.");
                                        color: root.pin-saved ? (root.dark-mode ? #34D399 : #047857) : root.text-muted;
                                        font-size: 10px;
                                        wrap: word-wrap;
                                    }

                                    ActionBtn {
                                        label: root.is-en ? "Clear Saved PIN & Privacy Data" : "Hapus PIN & Data Privasi";
                                        icon-name: "trash";
                                        danger: true;
                                        fb-state: root.fb-wipe-state;
                                        fb-label: root.fb-wipe-text;
                                        dark-mode: root.dark-mode;
                                        clicked => { root.wipe-privacy-data(); }
                                    }

                                    ActionBtn {
                                        label: root.is-en ? "Hide to System Tray" : "Sembunyikan ke System Tray";
                                        icon-name: "tray";
                                        dark-mode: root.dark-mode;
                                        clicked => { root.hide-to-tray(); }
                                    }
                                }

                                // CARD 7: KONEKSI & KONTROL MIRRORING
                                DrawerCard {
                                    title: root.is-en ? "CONNECTION & MIRRORING CONTROL" : "KONEKSI & KONTROL MIRRORING";
                                    dark-mode: root.dark-mode;

                                    Rectangle {
                                        height: 32px;
                                        border-radius: 16px;
                                        background: root.seg-track;
                                        HorizontalLayout {
                                            padding: 2px;
                                            spacing: 2px;
                                            SegPill {
                                                label: root.is-en ? "Cable" : "Kabel";
                                                icon-name: "usb";
                                                pill-height: 28px;
                                                active: root.transport-tab == "usb";
                                                dark-mode: root.dark-mode;
                                                clicked => { root.set-transport("usb"); }
                                            }
                                            SegPill {
                                                label: "Wi-Fi";
                                                icon-name: "wifi";
                                                pill-height: 28px;
                                                active: root.transport-tab == "wifi";
                                                dark-mode: root.dark-mode;
                                                clicked => { root.set-transport("wifi"); }
                                            }
                                        }
                                    }

                                    Text {
                                        text: root.wifi-status-text;
                                        color: root.dark-mode ? #34D399 : #047857;
                                        font-size: 11px;
                                        wrap: word-wrap;
                                    }

                                    HorizontalLayout {
                                        spacing: 6px;
                                        ActionBtn {
                                            horizontal-stretch: 1;
                                            label: root.is-en ? "Scan" : "Pindai";
                                            icon-name: "refresh";
                                            dark-mode: root.dark-mode;
                                            clicked => { root.scan-wifi(); }
                                        }
                                        ActionBtn {
                                            horizontal-stretch: 1;
                                            label: root.is-en ? "Set up Wi-Fi" : "Atur Wi-Fi";
                                            icon-name: "wifi";
                                            dark-mode: root.dark-mode;
                                            clicked => { root.pair-wifi(); }
                                        }
                                    }

                                    ActionBtn {
                                        label: root.is-streaming-or-starting
                                            ? (root.is-en ? "Disconnect Mirroring" : "Hentikan Mirroring")
                                            : (root.is-en ? "Start mirroring" : "Mulai mirroring");
                                        primary: !root.is-streaming-or-starting;
                                        danger: root.is-streaming-or-starting;
                                        dark-mode: root.dark-mode;
                                        clicked => {
                                            if (root.is-streaming-or-starting) {
                                                root.stop-mirror();
                                            } else {
                                                root.start-mirror();
                                            }
                                        }
                                    }

                                    ActionBtn {
                                        label: root.keyboard-enabled ? "Keyboard -> iPhone: On" : "Keyboard -> iPhone: Off";
                                        icon-name: "keyboard";
                                        emerald: root.keyboard-enabled;
                                        dark-mode: root.dark-mode;
                                        clicked => { root.toggle-onscreen-keyboard(); }
                                    }

                                    Text {
                                        text: root.is-en
                                            ? "Typing routes straight to iPhone. Swipe up from bottom edge for Home."
                                            : "Mengetik langsung masuk ke iPhone. Geser dari tepi bawah untuk Home.";
                                        color: root.text-muted;
                                        font-size: 10px;
                                        wrap: word-wrap;
                                    }
                                }

                                // CARD 8: PEMBARUAN PERANGKAT LUNAK
                                DrawerCard {
                                    title: root.is-en ? "SOFTWARE UPDATES" : "PEMBARUAN PERANGKAT LUNAK";
                                    dark-mode: root.dark-mode;

                                    DrawerAccordion {
                                        title: "iPhone Link v5.0.2";
                                        badge: root.update-available
                                            ? ((root.is-en ? "New v" : "Baru v") + root.latest-version)
                                            : (root.update-channel == "beta" ? "Beta" : (root.is-en ? "Stable" : "Stabil"));
                                        open: root.acc-updater-open;
                                        dark-mode: root.dark-mode;
                                        toggled => { root.acc-updater-open = !root.acc-updater-open; }

                                        HorizontalLayout {
                                            spacing: 8px;
                                            Text {
                                                text: root.is-en ? "Auto-check updates on launch" : "Cek pembaruan otomatis saat dibuka";
                                                color: root.text-primary;
                                                font-size: 11px;
                                                vertical-alignment: center;
                                                horizontal-stretch: 1;
                                            }
                                            Rectangle {
                                                width: 40px;
                                                height: 22px;
                                                border-radius: 11px;
                                                background: root.auto-check-update ? #10B981 : (root.dark-mode ? #4B5563 : #9CA3AF);
                                                animate background { duration: 160ms; easing: cubic-bezier(0.16, 1.0, 0.3, 1.0); }
                                                Rectangle {
                                                    x: root.auto-check-update ? 20px : 2px;
                                                    y: 2px;
                                                    width: 18px;
                                                    height: 18px;
                                                    border-radius: 9px;
                                                    background: #FFFFFF;
                                                    animate x { duration: 160ms; easing: cubic-bezier(0.16, 1.0, 0.3, 1.0); }
                                                }
                                                TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => { root.set-auto-check-update(!root.auto-check-update); }
                                                }
                                            }
                                        }

                                        HorizontalLayout {
                                            spacing: 8px;
                                            Text {
                                                text: root.is-en ? "Update Channel" : "Saluran Pembaruan";
                                                color: root.text-primary;
                                                font-size: 11px;
                                                vertical-alignment: center;
                                                horizontal-stretch: 1;
                                            }
                                            Rectangle {
                                                width: 126px;
                                                height: 30px;
                                                border-radius: 15px;
                                                background: root.seg-track;
                                                HorizontalLayout {
                                                    padding: 2px;
                                                    spacing: 2px;
                                                    SegPill {
                                                        label: root.is-en ? "Stable" : "Stabil";
                                                        font-px: 10.5px;
                                                        pill-height: 26px;
                                                        active: root.update-channel != "beta";
                                                        dark-mode: root.dark-mode;
                                                        clicked => { root.set-update-channel("stable"); }
                                                    }
                                                    SegPill {
                                                        label: "Beta";
                                                        font-px: 10.5px;
                                                        pill-height: 26px;
                                                        active: root.update-channel == "beta";
                                                        dark-mode: root.dark-mode;
                                                        clicked => { root.set-update-channel("beta"); }
                                                    }
                                                }
                                            }
                                        }

                                        if root.update-available : Rectangle {
                                            border-radius: 8px;
                                            border-width: 1px;
                                            border-color: #10B98166;
                                            background: #10B9811F;
                                            height: upd-banner-row.preferred-height + 12px;
                                            upd-banner-row := HorizontalLayout {
                                                x: 8px;
                                                y: 6px;
                                                width: parent.width - 16px;
                                                spacing: 6px;
                                                FluentIcon {
                                                    y: 1px;
                                                    name: "sparkles";
                                                    icon-size: 13px;
                                                    icon-color: root.dark-mode ? #34D399 : #047857;
                                                }
                                                Text {
                                                    horizontal-stretch: 1;
                                                    text: (root.is-en ? "Update ready: iPhone Link v" : "Pembaruan tersedia: iPhone Link v") + root.latest-version;
                                                    color: root.dark-mode ? #34D399 : #065F46;
                                                    font-size: 10.5px;
                                                    font-weight: 700;
                                                    wrap: word-wrap;
                                                }
                                            }
                                        }

                                        Text {
                                            text: root.update-status-text;
                                            color: root.text-muted;
                                            font-size: 10.5px;
                                            wrap: word-wrap;
                                        }

                                        ActionBtn {
                                            label: root.is-en ? "Check for Updates" : "Periksa Pembaruan";
                                            icon-name: "refresh";
                                            dark-mode: root.dark-mode;
                                            clicked => { root.check-updates(); }
                                        }

                                        if root.update-available : ActionBtn {
                                            label: root.is-en ? "Open Release Page" : "Buka Halaman Rilis";
                                            icon-name: "globe";
                                            primary: true;
                                            dark-mode: root.dark-mode;
                                            clicked => { root.open-update-release(); }
                                        }
                                    }
                                }

                                // CARD 9 (Collapsible Accordion): Detail Perangkat & Koneksi + Diagnostik 5-Titik + Tombol Hardware
                                DrawerAccordion {
                                    title: root.is-en ? "Device & Connection Details" : "Detail Perangkat & Koneksi";
                                    badge: "5";
                                    open: root.acc-details-open;
                                    dark-mode: root.dark-mode;
                                    toggled => { root.acc-details-open = !root.acc-details-open; }

                                    ActionBtn {
                                        label: root.is-en ? "Refresh Devices" : "Segarkan Perangkat";
                                        icon-name: "refresh";
                                        dark-mode: root.dark-mode;
                                        clicked => { root.scan-devices(); }
                                    }

                                    Text {
                                        text: root.device-pill-title + " · " + root.device-pill-detail;
                                        color: root.text-muted;
                                        font-size: 10.5px;
                                        wrap: word-wrap;
                                    }

                                    Text {
                                        text: root.is-en ? "5-POINT DIAGNOSTICS MATRIX" : "MATRIKS DIAGNOSTIK 5-TITIK";
                                        color: root.text-muted;
                                        font-size: 9.5px;
                                        font-weight: 700;
                                    }

                                    for diag in root.diagnostics : HorizontalLayout {
                                        spacing: 6px;
                                        Rectangle {
                                            y: 4px;
                                            width: 7px;
                                            height: 7px;
                                            border-radius: 3.5px;
                                            background: diag.ok ? #22C55E : #F59E0B;
                                        }
                                        Text {
                                            text: diag.label;
                                            color: root.text-primary;
                                            font-size: 11px;
                                            horizontal-stretch: 1;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: diag.status;
                                            color: diag.ok ? (root.dark-mode ? #34D399 : #047857) : (root.dark-mode ? #FBBF24 : #B45309);
                                            font-size: 10.5px;
                                            font-weight: 600;
                                        }
                                    }

                                    ActionBtn {
                                        label: root.is-en ? "Check 5-Point Diagnostics" : "Periksa Diagnostik 5-Titik";
                                        icon-name: "shield";
                                        dark-mode: root.dark-mode;
                                        clicked => { root.refresh-diagnostics(); }
                                    }

                                    HorizontalLayout {
                                        spacing: 6px;
                                        ActionBtn {
                                            horizontal-stretch: 1;
                                            label: "Developer Mode";
                                            icon-name: "sparkles";
                                            dark-mode: root.dark-mode;
                                            clicked => { root.unlock-developer-mode(); }
                                        }
                                        ActionBtn {
                                            horizontal-stretch: 1;
                                            label: root.is-en ? "Repair Driver" : "Perbaiki Driver";
                                            icon-name: "wrench";
                                            dark-mode: root.dark-mode;
                                            clicked => { root.repair-driver(); }
                                        }
                                    }

                                    ActionBtn {
                                        label: root.is-en ? "Copy Diagnostic Log" : "Salin Log Diagnostik";
                                        icon-name: "copy";
                                        fb-state: root.fb-diag-copy-state;
                                        fb-label: root.fb-diag-copy-text;
                                        dark-mode: root.dark-mode;
                                        clicked => { root.copy-diagnostic-log(); }
                                    }

                                    if root.diag-feedback-text != "" : Rectangle {
                                        border-radius: 8px;
                                        border-width: 1px;
                                        border-color: root.diag-feedback-ok ? #10B98166 : #F59E0B66;
                                        background: root.diag-feedback-ok ? #10B9811F : #F59E0B1F;
                                        height: diag-fb-row.preferred-height + 12px;
                                        diag-fb-row := HorizontalLayout {
                                            x: 8px;
                                            y: 6px;
                                            width: parent.width - 16px;
                                            spacing: 6px;
                                            FluentIcon {
                                                y: 1px;
                                                name: root.diag-feedback-ok ? "check" : "warning";
                                                icon-size: 13px;
                                                icon-color: root.diag-feedback-ok
                                                    ? (root.dark-mode ? #34D399 : #047857)
                                                    : (root.dark-mode ? #FBBF24 : #B45309);
                                            }
                                            Text {
                                                horizontal-stretch: 1;
                                                text: root.diag-feedback-text;
                                                color: root.text-primary;
                                                font-size: 10.5px;
                                                wrap: word-wrap;
                                            }
                                        }
                                    }

                                    Text {
                                        text: root.is-en ? "HARDWARE KEYS" : "TOMBOL PERANGKAT KERAS";
                                        color: root.text-muted;
                                        font-size: 9.5px;
                                        font-weight: 700;
                                    }

                                    HorizontalLayout {
                                        spacing: 5px;
                                        ActionBtn {
                                            horizontal-stretch: 1;
                                            label: root.is-en ? "Notifications" : "Notifikasi";
                                            icon-name: "bell";
                                            dark-mode: root.dark-mode;
                                            clicked => { root.hardware-button("notifications"); }
                                        }
                                        ActionBtn {
                                            horizontal-stretch: 1;
                                            label: root.is-en ? "Control" : "Kontrol";
                                            icon-name: "sliders";
                                            dark-mode: root.dark-mode;
                                            clicked => { root.hardware-button("control_center"); }
                                        }
                                        ActionBtn {
                                            horizontal-stretch: 1;
                                            label: root.is-en ? "Lock" : "Kunci";
                                            icon-name: "lock";
                                            dark-mode: root.dark-mode;
                                            clicked => { root.hardware-button("lock"); }
                                        }
                                    }
                                    HorizontalLayout {
                                        spacing: 5px;
                                        ActionBtn {
                                            horizontal-stretch: 1;
                                            label: root.is-en ? "Mute" : "Bisu";
                                            icon-name: "audio-off";
                                            dark-mode: root.dark-mode;
                                            clicked => { root.hardware-button("mute"); }
                                        }
                                        ActionBtn {
                                            horizontal-stretch: 1;
                                            label: "Vol +";
                                            icon-name: "volume-up";
                                            dark-mode: root.dark-mode;
                                            clicked => { root.hardware-button("volume_up"); }
                                        }
                                        ActionBtn {
                                            horizontal-stretch: 1;
                                            label: "Vol -";
                                            icon-name: "volume-down";
                                            dark-mode: root.dark-mode;
                                            clicked => { root.hardware-button("volume_down"); }
                                        }
                                    }
                                }

                                // CARD 10 (Collapsible Accordion): Panduan & Pemecahan Masalah
                                DrawerAccordion {
                                    title: root.is-en ? "Guide & Troubleshooting" : "Panduan & Pemecahan Masalah";
                                    open: root.acc-guide-open;
                                    dark-mode: root.dark-mode;
                                    toggled => { root.acc-guide-open = !root.acc-guide-open; }

                                    Text {
                                        text: root.is-en
                                            ? "1. Connect iPhone via USB & tap Trust.\n2. Enable Settings > Privacy & Security > Developer Mode.\n3. Tap Set up Wi-Fi once via USB, then stream over LAN.\n4. Use AirPlay H.264 mode as universal fallback."
                                            : "1. Hubungkan iPhone via USB & ketuk Percayai.\n2. Aktifkan Pengaturan > Privasi & Keamanan > Mode Pengembang.\n3. Klik Atur Wi-Fi sekali lewat USB, lalu mirror nirkabel.\n4. Gunakan mode AirPlay H.264 sebagai cadangan universal.";
                                        color: root.text-muted;
                                        font-size: 10.5px;
                                        wrap: word-wrap;
                                    }
                                }

                                // OFFICIAL v4.0.0 SAWERIA CREATOR FOOTER BLOCK
                                Rectangle {
                                    border-radius: 12px;
                                    border-width: 1px;
                                    border-color: root.border-chrome;
                                    background: transparent;

                                    VerticalLayout {
                                        padding-top: 8px;
                                        padding-bottom: 6px;
                                        padding-left: 4px;
                                        padding-right: 4px;
                                        spacing: 8px;

                                        // Warm Amber Glass Saweria Button
                                        Rectangle {
                                            height: 36px;
                                            border-radius: 10px;
                                            border-width: 1px;
                                            border-color: sw-ta.has-hover ? #F59E0B : #F59E0B99;
                                            background: sw-ta.has-hover
                                                ? (root.dark-mode ? #F59E0B42 : #F59E0B47)
                                                : (root.dark-mode ? #F59E0B29 : #F59E0B2E);
                                            animate background { duration: 160ms; easing: cubic-bezier(0.16, 1.0, 0.3, 1.0); }
                                            animate border-color { duration: 160ms; easing: cubic-bezier(0.16, 1.0, 0.3, 1.0); }

                                            HorizontalLayout {
                                                alignment: center;
                                                spacing: 7px;
                                                FluentIcon {
                                                    y: (parent.height - self.height) / 2;
                                                    name: "coffee-cup";
                                                    icon-size: 14px;
                                                    icon-color: root.dark-mode ? #F59E0B : #92400E;
                                                }
                                                Text {
                                                    text: root.is-en ? "Support Creator on Saweria" : "Dukung Kreator di Saweria";
                                                    color: root.dark-mode ? #F59E0B : #92400E;
                                                    font-size: 12px;
                                                    font-weight: 700;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            sw-ta := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.open-external-url("https://saweria.co/kelvindaniyar"); }
                                            }
                                        }

                                        // Clean Creator Attribution Row: "iPhone Link v5.0.2 by Kelvin Daniyar · GPL-3.0"
                                        HorizontalLayout {
                                            alignment: center;
                                            spacing: 0px;
                                            Text {
                                                text: "iPhone Link v5.0.2 by ";
                                                color: root.dark-mode ? #CBD5E1 : #0F172A;
                                                font-size: 10.5px;
                                                font-weight: 600;
                                                vertical-alignment: center;
                                            }
                                            TouchArea {
                                                width: auth-txt.preferred-width;
                                                height: 18px;
                                                mouse-cursor: pointer;
                                                clicked => { root.open-external-url("https://github.com/kelvindaniyar"); }
                                                auth-txt := Text {
                                                    text: "Kelvin Daniyar";
                                                    color: root.dark-mode ? #38BDF8 : #0284C7;
                                                    font-size: 10.5px;
                                                    font-weight: 700;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            Text {
                                                text: " · GPL-3.0";
                                                color: root.dark-mode ? #CBD5E1 : #334155;
                                                font-size: 10.5px;
                                                font-weight: 600;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
